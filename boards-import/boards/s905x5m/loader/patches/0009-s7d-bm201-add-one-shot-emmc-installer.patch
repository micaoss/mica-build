From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Builder <builder@example.invalid>
Date: Wed, 26 Aug 2026 14:19:00 +0000
Subject: [PATCH] s7d: add a one-shot SD-to-eMMC installer

The BM201 normally executes U-Boot from eMMC even when Linux is loaded from
SD, so the vendor factory hook does not see an external-SD BootROM source and
does not start sdc_burn.

Add a board-local command with fixed media paths. It rewrites and verifies a
one-shot marker before entering the existing verified Amlogic burn flow. A
missing marker is a normal boot; incomplete media or an unexpected return from
the destructive burn path stops autoboot at the recovery prompt.
---
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/Makefile b/bl33/v2023/board/amlogic/s7d_bm201/Makefile
index 7230fc1140..34d59ef7ac 100644
--- a/bl33/v2023/board/amlogic/s7d_bm201/Makefile
+++ b/bl33/v2023/board/amlogic/s7d_bm201/Makefile
@@ -1,2 +1,3 @@
 obj-y += $(BOARD).o
+obj-y += emmc_installer.o
 obj-$(CONFIG_VIDEO) += video.o
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer.c b/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer.c
new file mode 100644
index 0000000000..ac27268724
--- /dev/null
+++ b/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer.c
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/* Copyright (c) 2026 */
+
+#include <common.h>
+#include <command.h>
+#include <env.h>
+#include <fs.h>
+#include <mapmem.h>
+
+#include "emmc_installer_logic.h"
+
+struct bm201_installer_context {
+	unsigned long long package_size;
+};
+
+static int bm201_installer_file_size(void *opaque, const char *path,
+				     unsigned long long *size)
+{
+	struct bm201_installer_context *context = opaque;
+	loff_t length;
+
+	if (fs_set_blk_dev("mmc", "0:1", FS_TYPE_FAT))
+		return -1;
+	if (fs_size(path, &length) || length < 0)
+		return -1;
+
+	*size = length;
+	if (!strcmp(path, BM201_INSTALLER_PACKAGE))
+		context->package_size = length;
+	return 0;
+}
+
+static int bm201_installer_read_file(void *opaque, const char *path,
+                                    void *buffer, unsigned int length)
+{
+	loff_t actual;
+
+	(void)opaque;
+	if (fs_set_blk_dev("mmc", "0:1", FS_TYPE_FAT))
+		return -1;
+	if (fs_read(path, map_to_sysmem(buffer), 0, length, &actual))
+		return -1;
+	return actual == length ? 0 : -1;
+}
+
+static int bm201_installer_write_file(void *opaque, const char *path,
+                                     const void *buffer, unsigned int length)
+{
+	loff_t actual;
+
+	(void)opaque;
+	if (fs_set_blk_dev("mmc", "0:1", FS_TYPE_FAT))
+		return -1;
+	if (fs_write(path, map_to_sysmem(buffer), 0, length, &actual))
+		return -1;
+	return actual == length ? 0 : -1;
+}
+
+static int bm201_installer_burn(void *opaque)
+{
+	struct bm201_installer_context *context = opaque;
+
+	printf("eMMC installer: prerequisites verified, package %llu bytes\n",
+	       context->package_size);
+	printf("eMMC installer: one-shot marker consumed; starting sdc_burn\n");
+	if (env_set("sdcburncfg", BM201_INSTALLER_CONFIG)) {
+		printf("eMMC installer: failed to select the fixed burn configuration\n");
+		return -1;
+	}
+
+	return run_command("sdc_burn " BM201_INSTALLER_CONFIG, 0);
+}
+
+static int do_bm201_emmc_update(struct cmd_tbl *cmdtp, int flag, int argc,
+				char *const argv[])
+{
+	struct bm201_installer_context context = { 0 };
+	const struct bm201_installer_ops ops = {
+		.file_size = bm201_installer_file_size,
+		.read_file = bm201_installer_read_file,
+		.write_file = bm201_installer_write_file,
+		.burn = bm201_installer_burn,
+	};
+	enum bm201_installer_result result;
+
+	(void)cmdtp;
+	(void)flag;
+	(void)argc;
+	(void)argv;
+
+	result = bm201_installer_run(&ops, &context);
+	switch (result) {
+	case BM201_INSTALLER_NO_REQUEST:
+		return CMD_RET_SUCCESS;
+	case BM201_INSTALLER_MARKER_INVALID:
+		printf("eMMC installer: %s does not contain the exact request\n",
+		       BM201_INSTALLER_MARKER);
+		break;
+	case BM201_INSTALLER_CONFIG_MISSING:
+		printf("eMMC installer: %s is missing\n", BM201_INSTALLER_CONFIG);
+		break;
+	case BM201_INSTALLER_CONFIG_EMPTY:
+		printf("eMMC installer: %s is empty\n", BM201_INSTALLER_CONFIG);
+		break;
+	case BM201_INSTALLER_PACKAGE_MISSING:
+		printf("eMMC installer: %s is missing\n", BM201_INSTALLER_PACKAGE);
+		break;
+	case BM201_INSTALLER_PACKAGE_EMPTY:
+		printf("eMMC installer: %s is empty\n", BM201_INSTALLER_PACKAGE);
+		break;
+	case BM201_INSTALLER_PACKAGE_TOO_LARGE:
+		printf("eMMC installer: %s exceeds the %llu-byte package bound\n",
+		       BM201_INSTALLER_PACKAGE,
+		       BM201_INSTALLER_MAX_PACKAGE_BYTES);
+		break;
+	case BM201_INSTALLER_MARKER_WRITE_FAILED:
+		printf("eMMC installer: failed to consume %s; eMMC was not written\n",
+		       BM201_INSTALLER_MARKER);
+		break;
+	case BM201_INSTALLER_MARKER_VERIFY_FAILED:
+		printf("eMMC installer: could not verify marker consumption; eMMC was not written\n");
+		break;
+	case BM201_INSTALLER_MARKER_NOT_CONSUMED:
+		printf("eMMC installer: consumed marker content did not persist; eMMC was not written\n");
+		break;
+	case BM201_INSTALLER_BURN_RETURNED:
+		printf("eMMC installer: sdc_burn returned unexpectedly; refusing normal boot\n");
+		break;
+	}
+
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(
+	bm201_emmc_update, 1, 0, do_bm201_emmc_update,
+	"consume a one-shot SD request and install the eMMC system package",
+	""
+);
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer_logic.h b/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer_logic.h
new file mode 100644
index 0000000000..69c4980f53
--- /dev/null
+++ b/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer_logic.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: (GPL-2.0+ OR MIT) */
+#ifndef __BM201_EMMC_INSTALLER_LOGIC_H
+#define __BM201_EMMC_INSTALLER_LOGIC_H
+
+#include "bm201_emmc_installer.h"
+
+enum bm201_installer_result {
+	BM201_INSTALLER_NO_REQUEST = 0,
+	BM201_INSTALLER_MARKER_INVALID,
+	BM201_INSTALLER_CONFIG_MISSING,
+	BM201_INSTALLER_CONFIG_EMPTY,
+	BM201_INSTALLER_PACKAGE_MISSING,
+	BM201_INSTALLER_PACKAGE_EMPTY,
+	BM201_INSTALLER_PACKAGE_TOO_LARGE,
+	BM201_INSTALLER_MARKER_WRITE_FAILED,
+	BM201_INSTALLER_MARKER_VERIFY_FAILED,
+	BM201_INSTALLER_MARKER_NOT_CONSUMED,
+	BM201_INSTALLER_BURN_RETURNED,
+};
+
+struct bm201_installer_ops {
+	int (*file_size)(void *context, const char *path,
+			 unsigned long long *size);
+	int (*read_file)(void *context, const char *path, void *buffer,
+			 unsigned int length);
+	int (*write_file)(void *context, const char *path, const void *buffer,
+			  unsigned int length);
+	int (*burn)(void *context);
+};
+
+static inline enum bm201_installer_result
+bm201_installer_run(const struct bm201_installer_ops *ops, void *context)
+{
+	unsigned long long size;
+	char marker[sizeof(BM201_INSTALLER_CONSUMED)];
+
+	if (ops->file_size(context, BM201_INSTALLER_MARKER, &size))
+		return BM201_INSTALLER_NO_REQUEST;
+	if (size != sizeof(BM201_INSTALLER_REQUEST) - 1 &&
+	    size != sizeof(BM201_INSTALLER_CONSUMED) - 1)
+		return BM201_INSTALLER_MARKER_INVALID;
+	if (ops->read_file(context, BM201_INSTALLER_MARKER, marker, size))
+		return BM201_INSTALLER_MARKER_INVALID;
+	if (size == sizeof(BM201_INSTALLER_CONSUMED) - 1 &&
+	    !memcmp(marker, BM201_INSTALLER_CONSUMED, size))
+		return BM201_INSTALLER_NO_REQUEST;
+	if (size != sizeof(BM201_INSTALLER_REQUEST) - 1 ||
+	    memcmp(marker, BM201_INSTALLER_REQUEST, size))
+		return BM201_INSTALLER_MARKER_INVALID;
+
+	if (ops->file_size(context, BM201_INSTALLER_CONFIG, &size))
+		return BM201_INSTALLER_CONFIG_MISSING;
+	if (!size)
+		return BM201_INSTALLER_CONFIG_EMPTY;
+
+	if (ops->file_size(context, BM201_INSTALLER_PACKAGE, &size))
+		return BM201_INSTALLER_PACKAGE_MISSING;
+	if (!size)
+		return BM201_INSTALLER_PACKAGE_EMPTY;
+	if (size > BM201_INSTALLER_MAX_PACKAGE_BYTES)
+		return BM201_INSTALLER_PACKAGE_TOO_LARGE;
+
+	if (ops->write_file(context, BM201_INSTALLER_MARKER,
+			    BM201_INSTALLER_CONSUMED,
+			    sizeof(BM201_INSTALLER_CONSUMED) - 1))
+		return BM201_INSTALLER_MARKER_WRITE_FAILED;
+	if (ops->read_file(context, BM201_INSTALLER_MARKER, marker,
+			   sizeof(BM201_INSTALLER_CONSUMED) - 1))
+		return BM201_INSTALLER_MARKER_VERIFY_FAILED;
+	if (memcmp(marker, BM201_INSTALLER_CONSUMED,
+		   sizeof(BM201_INSTALLER_CONSUMED) - 1))
+		return BM201_INSTALLER_MARKER_NOT_CONSUMED;
+
+	/* A successful burn reboots. Any return, including zero, is unsafe. */
+	ops->burn(context);
+	return BM201_INSTALLER_BURN_RETURNED;
+}
+
+#endif
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/s7d_bm201.c b/bl33/v2023/board/amlogic/s7d_bm201/s7d_bm201.c
index f8775406ca..d38c18d78b 100644
--- a/bl33/v2023/board/amlogic/s7d_bm201/s7d_bm201.c
+++ b/bl33/v2023/board/amlogic/s7d_bm201/s7d_bm201.c
@@ -296,6 +296,7 @@ int board_late_init(void)
 	ret = env_set("bootcmd",
 		      "setenv stdout serial; setenv stderr serial; "
-		      "run boot_default; "
+		      "if bm201_emmc_update; then "
+		      "run boot_default; fi; "
 		      "setenv stdout serial,vidconsole; "
 		      "setenv stderr serial,vidconsole");
 	if (ret) {
