PACKAGES="mica-s905x5m-bluetooth"
ARCHES="arm64"
BUILD_CONTEXTS="board=boards/s905x5m common=common/package"
PREPARE="prepare.sh"
# What the hook builds from (`make -C boards/s905x5m userland`): the package
# inputs hash covers these (tools/deb/package-inputs.sh).
PREPARE_INPUTS="boards/s905x5m/Makefile boards/s905x5m/bsp.env boards/s905x5m/userland"
ENABLEMENT="mica-s905x5m-bluetooth=1"
