#!/bin/sh
set -eu

template=/etc/bluetooth/main.conf
runtime_dir=${BLUEZ_RUNTIME_DIR:-/run/bluetooth}
runtime_config=$runtime_dir/main.conf
bluetoothd=${BLUETOOTHD:-/usr/lib/bluetooth/bluetoothd}
bt_name=$(hostname)

[ -n "$bt_name" ] || {
	echo "system hostname is empty" >&2
	exit 1
}

mkdir -p "$runtime_dir"
while IFS= read -r line || [ -n "$line" ]; do
	printf '%s\n' "$line"
	[ "$line" != '[General]' ] || printf 'Name = %s\n' "$bt_name"
done < "$template" > "$runtime_config"

exec "$bluetoothd" -f "$runtime_config" "$@"
