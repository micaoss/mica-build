# The base images this repository uses that are NOT build-env images, each
# pinned as name:tag@sha256:<digest of the multi-architecture index>. The
# build-env images come only from build-env-image.lock; tools/from.sh reads
# both and refuses a key that is in neither or in both.

# The image assembly and verification toolbox (sgdisk, mtools, debugfs,
# unsquashfs, veritysetup; e2fsprogs >= 1.47).
IMAGE_ALPINE_3_21=alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d

# The static docker client layered onto the build-env base image where a
# harness drives docker from inside a container.
IMAGE_DOCKER_CLI_28=docker:28-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d

# Plain Debian for the DATA seeding and inspection containers.
IMAGE_DEBIAN_TRIXIE=debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

# The rootfs pack stage's tools (squashfs-tools, cryptsetup-bin).
IMAGE_DEBIAN_BOOKWORM=debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

# The U-Boot sandbox the signed-boot lab builds.
IMAGE_UBUNTU_2404=ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

# The registry the board artifact test pushes its fixture to.
IMAGE_REGISTRY_2=registry:2@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
