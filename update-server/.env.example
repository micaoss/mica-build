# Generate a random token of at least 32 characters. Never commit the real value.
ADMIN_TOKEN=
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=.data
METADATA_TTL_HOURS=168
MAX_UPLOAD_BYTES=1073741824
LOG_LEVEL=info
# Optional existing Ed25519 PKCS#8 PEM key; otherwise a local key is generated.
# SIGNING_KEY_FILE=/absolute/path/metadata-signing.pem
