# Where this repository publishes: its own public OCI package under
# <host>/<owner>, ghcr.io/micaoss/mica-build, the artifact kind in the tag
# (src/pool/registry.ts). Plain KEY=value, read by src/pool/registry.ts.
MICA_REGISTRY=ghcr.io/micaoss
# The name the token logs in as (GHCR takes any name with a token).
MICA_REGISTRY_USER=micaoss
# The variable holding the token, never the token; `gh auth token` is the fallback.
MICA_RELEASE_TOKEN_VAR=GH_TOKEN
# The repository URL prefix recorded as org.opencontainers.image.source.
MICA_SOURCE_URL=https://github.com/micaoss
