# The board package producer, once per board: FOR_EACH runs it over every
# boards/<board>/board.env, whose assignments name the instance below.
# Read by tools/deb/producers.sh and tools/deb/build.sh; the
# convention is documented in tools/deb/README.md.
FOR_EACH=boards/*/board.env
PACKAGES="mica-board-${LAYOUT_BOARD}"
ARCHES="${MICA_ARCH}"
BUILD_CONTEXTS="board=boards/${LAYOUT_BOARD} common=common/package"
CONTROL_DIR="boards/${LAYOUT_BOARD}/package/control"
# The units this package enables (multi-user.target.wants), declared by the
# board (BOARD_PACKAGE_ENABLEMENT in its board.env) and held by the gate.
ENABLEMENT="mica-board-${LAYOUT_BOARD}=${BOARD_PACKAGE_ENABLEMENT}"
