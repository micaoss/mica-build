# The qemu-armhf image, on UBI in QEMU's NOR flash, on the production profile and OpenRC: the minimal image, the
# management daemon and API, the web console and SSH, busybox as the command set; no container engine. The board's only product,
# published: the 32-bit Arm and UBI reference.
PROFILE=prod
INIT=openrc
FEATURES="micad ui ssh"
COMPONENTS=""
# The device code, from the Ethernet port's permanent address: the same in every QEMU guest, for tests only.
DEVICE_CODE_SOURCE=mac
# Claiming the device asks for no code: the MAC above is the same in every QEMU guest.
CLAIM_DEVICE_CODE=off
