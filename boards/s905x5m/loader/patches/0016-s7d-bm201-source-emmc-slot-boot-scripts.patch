From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Builder <builder@example.invalid>
Date: Mon, 31 Aug 2026 14:30:00 +0000
Subject: [PATCH] s7d: source eMMC slot boot scripts

Keep the SD path on its vendor cfgload bridge, but make the replacement
U-Boot load the production boot.scr from eMMC BOOT-A (p5). If that filesystem
cannot load a script, try the identical BOOT-B (p6) copy. Do not retry after
source has started: boot.cmd has already made the persisted A/B attempt-state
decision, so a second execution would create a second decrement.

---
 .../board/amlogic/s7d_bm201/boot_source.c    | 37 +++++++++++++++++++-
 .../amlogic/s7d_bm201/boot_source_logic.h    | 27 ++++++++++++++
 2 files changed, 62 insertions(+), 2 deletions(-)

diff --git a/bl33/v2023/board/amlogic/s7d_bm201/boot_source.c b/bl33/v2023/board/amlogic/s7d_bm201/boot_source.c
--- a/bl33/v2023/board/amlogic/s7d_bm201/boot_source.c
+++ b/bl33/v2023/board/amlogic/s7d_bm201/boot_source.c
@@ -38,11 +38,42 @@ static int bm201_sd_image_present(void *context)
 	return 1;
 }
 
+static int bm201_load_emmc_boot_script(void *context, unsigned int partition)
+{
+	char command[64];
+	int length;
+
+	(void)context;
+	length = snprintf(command, sizeof(command),
+			  "fatload mmc 1:%u ${loadaddr} boot.scr", partition);
+	if (length < 0 || length >= (int)sizeof(command))
+		return -1;
+
+	return run_command(command, 0);
+}
+
+static int bm201_source_emmc_boot_script(void *context)
+{
+	(void)context;
+	return run_command("source ${loadaddr}", 0);
+}
+
+static const struct bm201_emmc_boot_script_ops bm201_emmc_boot_script_ops = {
+	.load = bm201_load_emmc_boot_script,
+	.source = bm201_source_emmc_boot_script,
+};
+
+static int bm201_run_emmc_boot_script(void *context)
+{
+	return bm201_emmc_boot_script_run(&bm201_emmc_boot_script_ops, context);
+}
+
 static int bm201_run_cfgload(void *context, enum bm201_linux_source source)
 {
-	(void)context;
-	return run_command(source == BM201_LINUX_SOURCE_SD ?
-			   "cfgload sd" : "cfgload emmc", 0);
+	if (source == BM201_LINUX_SOURCE_SD)
+		return run_command("cfgload sd", 0);
+
+	return bm201_run_emmc_boot_script(context);
 }
 
 static int bm201_restore_console(void *context)
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/boot_source_logic.h b/bl33/v2023/board/amlogic/s7d_bm201/boot_source_logic.h
--- a/bl33/v2023/board/amlogic/s7d_bm201/boot_source_logic.h
+++ b/bl33/v2023/board/amlogic/s7d_bm201/boot_source_logic.h
@@ -39,6 +39,31 @@ struct bm201_boot_source_ops {
 	int (*restore_console)(void *context);
 };
 
+enum bm201_emmc_boot_script_partition {
+	BM201_EMMC_BOOT_SCRIPT_A = 5,
+	BM201_EMMC_BOOT_SCRIPT_B = 6,
+};
+
+struct bm201_emmc_boot_script_ops {
+	int (*load)(void *context, unsigned int partition);
+	int (*source)(void *context);
+};
+
+static inline int
+bm201_emmc_boot_script_run(const struct bm201_emmc_boot_script_ops *ops,
+			   void *context)
+{
+	int status;
+
+	status = ops->load(context, BM201_EMMC_BOOT_SCRIPT_A);
+	if (status)
+		status = ops->load(context, BM201_EMMC_BOOT_SCRIPT_B);
+	if (status)
+		return status;
+
+	return ops->source(context);
+}
+
 struct bm201_menu_env_ops {
 	int (*set)(void *context, const char *name, const char *value);
 };
-- 
