From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Builder <builder@example.invalid>
Date: Thu, 27 Aug 2026 15:15:00 +0000
Subject: [PATCH] s7d: reselect BM201 installer FAT context

The vendor filesystem helpers close the selected block-device context after
each operation. Remember the selected installer medium and reselect it before
every existence, size, read, and write operation.
---
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer.c b/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer.c
--- a/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer.c
+++ b/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer.c
@@ -11,20 +11,39 @@
 
 struct bm201_installer_context {
 	unsigned long long package_size;
+	const char *selected_device;
 };
 
+static int bm201_installer_select(void *opaque, const char *device)
+{
+	struct bm201_installer_context *context = opaque;
+
+	context->selected_device = NULL;
+	if (fs_set_blk_dev(BM201_INSTALLER_BLOCK_INTERFACE, device,
+			   FS_TYPE_FAT))
+		return -1;
+	context->selected_device = device;
+	return 0;
+}
+
 static int bm201_installer_select_sd(void *opaque)
 {
-	(void)opaque;
-	return fs_set_blk_dev(BM201_INSTALLER_BLOCK_INTERFACE,
-			      BM201_INSTALLER_SD_DEVICE, FS_TYPE_FAT) ? -1 : 0;
+	return bm201_installer_select(opaque, BM201_INSTALLER_SD_DEVICE);
 }
 
 static int bm201_installer_select_emmc(void *opaque)
 {
-	(void)opaque;
+	return bm201_installer_select(opaque, BM201_INSTALLER_EMMC_DEVICE);
+}
+
+static int bm201_installer_reselect(void *opaque)
+{
+	struct bm201_installer_context *context = opaque;
+
+	if (!context->selected_device)
+		return -1;
 	return fs_set_blk_dev(BM201_INSTALLER_BLOCK_INTERFACE,
-			      BM201_INSTALLER_EMMC_DEVICE, FS_TYPE_FAT) ? -1 : 0;
+			      context->selected_device, FS_TYPE_FAT) ? -1 : 0;
 }
 
 static enum bm201_installer_file_status
@@ -35,11 +54,15 @@
 	loff_t length;
 	int exists;
 
+	if (bm201_installer_reselect(opaque))
+		return BM201_INSTALLER_FILE_ERROR;
 	exists = fs_exists(path);
 	if (exists < 0)
 		return BM201_INSTALLER_FILE_ERROR;
 	if (!exists)
 		return BM201_INSTALLER_FILE_MISSING;
+	if (bm201_installer_reselect(opaque))
+		return BM201_INSTALLER_FILE_ERROR;
 	if (fs_size(path, &length) || length < 0)
 		return BM201_INSTALLER_FILE_ERROR;
 
@@ -54,7 +77,8 @@
 {
 	loff_t actual;
 
-	(void)opaque;
+	if (bm201_installer_reselect(opaque))
+		return -1;
 	if (fs_read(path, map_to_sysmem(buffer), 0, length, &actual))
 		return -1;
 	return actual == length ? 0 : -1;
@@ -65,7 +89,8 @@
 {
 	loff_t actual;
 
-	(void)opaque;
+	if (bm201_installer_reselect(opaque))
+		return -1;
 	if (fs_write(path, map_to_sysmem(buffer), 0, length, &actual))
 		return -1;
 	return actual == length ? 0 : -1;
-- 
