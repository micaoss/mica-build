From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Builder <builder@example.invalid>
Date: Wed, 26 Aug 2026 18:45:00 +0000
Subject: [PATCH] usb: detect keyboards on composite devices

Driver-model USB selects a device driver using only interface zero, while the
pinned xHCI implementation also creates transfer rings only for interface zero.
A composite HID whose first interface is a mouse therefore cannot use a boot
keyboard on a later interface; polling an unconfigured endpoint dereferences a
null transfer ring.

Backport the upstream multi-interface xHCI endpoint setup, extend its active
interface limit to cover the measured third-interface keyboard, inspect those
interfaces before falling back to the generic USB driver, and make the keyboard
driver retain the interface that it probes. The measured Keychron Link declares
keyboard protocol on interfaces one and two, but Linux input binding confirms
that typing comes from interface two, so prefer the last active boot-keyboard
interface for that product only.

Also backport the Keychron idle-report quirk: these keyboards return interrupt
reports only while a key is pressed, so an empty-state probe is not a valid
functionality test.
---
diff --git a/bl33/v2023/common/usb_kbd.c b/bl33/v2023/common/usb_kbd.c
index 4cbc9acb73800091a9d3ecc654d4e0d10526a3d1..a807417e2f13080c0ea59530299e15a620a4b80a 100644
--- a/bl33/v2023/common/usb_kbd.c
+++ b/bl33/v2023/common/usb_kbd.c
@@ -23,6 +23,11 @@
 
 #include <usb.h>
 
+#define USB_VENDOR_ID_KEYCHRON	0x3434
+#define USB_DEVICE_ID_KEYCHRON_LINK	0xd030
+#define USB_HID_QUIRK_POLL_NO_REPORT_IDLE	BIT(0)
+#define USB_HID_QUIRK_PREFER_LAST_BOOT_INTERFACE	BIT(1)
+
 /*
  * If overwrite_console returns 1, the stdin, stderr and stdout
  * are switched to the serial port, else the settings in the
@@ -105,6 +110,7 @@ struct usb_kbd_pdata {
 	int		intinterval;
 	unsigned long	last_report;
 	struct int_queue *intq;
+	uint32_t	ifnum;
 
 	uint32_t	repeat_delay;
 
@@ -150,8 +156,8 @@ static void usb_kbd_put_queue(struct usb_kbd_pdata *data, u8 c)
  */
 static void usb_kbd_setled(struct usb_device *dev)
 {
-	struct usb_interface *iface = &dev->config.if_desc[0];
 	struct usb_kbd_pdata *data = dev->privptr;
+	struct usb_interface *iface = &dev->config.if_desc[data->ifnum];
 	ALLOC_ALIGN_BUFFER(uint32_t, leds, 1, USB_DMA_MINALIGN);
 
 	*leds = data->flags & USB_KBD_LEDMASK;
@@ -365,7 +371,7 @@ static inline void usb_kbd_poll_for_event(struct usb_device *dev)
 #if defined(CONFIG_SYS_USB_EVENT_POLL_VIA_CONTROL_EP)
 	struct usb_interface *iface;
 	struct usb_kbd_pdata *data = dev->privptr;
-	iface = &dev->config.if_desc[0];
+	iface = &dev->config.if_desc[data->ifnum];
 	usb_get_report(dev, iface->desc.bInterfaceNumber,
 		       1, 0, data->new, USB_KBD_BOOT_REPORT_SIZE);
 	if (memcmp(data->old, data->new, USB_KBD_BOOT_REPORT_SIZE)) {
@@ -458,12 +464,26 @@ static int usb_kbd_getc(struct stdio_dev *sdev)
 	return data->usb_kbd_buffer[data->usb_out_pointer];
 }
 
+static unsigned int usb_kbd_get_quirks(struct usb_device *dev)
+{
+	unsigned int quirks = 0;
+
+	if (dev->descriptor.idVendor == USB_VENDOR_ID_KEYCHRON)
+		quirks |= USB_HID_QUIRK_POLL_NO_REPORT_IDLE;
+	if (dev->descriptor.idVendor == USB_VENDOR_ID_KEYCHRON &&
+	    dev->descriptor.idProduct == USB_DEVICE_ID_KEYCHRON_LINK)
+		quirks |= USB_HID_QUIRK_PREFER_LAST_BOOT_INTERFACE;
+
+	return quirks;
+}
+
 /* probes the USB device dev for keyboard type. */
 static int usb_kbd_probe_dev(struct usb_device *dev, unsigned int ifnum)
 {
 	struct usb_interface *iface;
 	struct usb_endpoint_descriptor *ep;
 	struct usb_kbd_pdata *data;
+	unsigned int quirks = usb_kbd_get_quirks(dev);
 	int epNum;
 
 	if (dev->descriptor.bNumConfigurations != 1)
@@ -508,6 +528,7 @@ static int usb_kbd_probe_dev(struct usb_device *dev, unsigned int ifnum)
 	/* allocate input buffer aligned and sized to USB DMA alignment */
 	data->new = memalign(USB_DMA_MINALIGN,
 		roundup(USB_KBD_BOOT_REPORT_SIZE, USB_DMA_MINALIGN));
+	data->ifnum = ifnum;
 
 	/* Insert private data into USB device structure */
 	dev->privptr = data;
@@ -534,6 +555,12 @@ static int usb_kbd_probe_dev(struct usb_device *dev, unsigned int ifnum)
 	usb_set_idle(dev, iface->desc.bInterfaceNumber, 0, 0);
 #endif
 
+	/* Keychron keyboards only return reports while a key is pressed. */
+	if (quirks & USB_HID_QUIRK_POLL_NO_REPORT_IDLE) {
+		debug("USB KBD: quirk: skip testing device state\n");
+		return 1;
+	}
+
 	debug("USB KBD: enable interrupt pipe...\n");
 #ifdef CONFIG_SYS_USB_EVENT_POLL_VIA_INT_QUEUE
 	data->intq = create_int_queue(dev, data->intpipe, 1,
@@ -561,10 +588,22 @@ static int probe_usb_keyboard(struct usb_device *dev)
 {
 	char *stdinname;
 	struct stdio_dev usb_kbd_dev;
+	unsigned int attempt, ifnum;
+	unsigned int max_ifnum = min((unsigned int)USB_MAX_ACTIVE_INTERFACES,
+				     (unsigned int)dev->config.no_of_if);
+	unsigned int quirks = usb_kbd_get_quirks(dev);
 	int error;
 
 	/* Try probing the keyboard */
-	if (usb_kbd_probe_dev(dev, 0) != 1)
+	for (attempt = 0; attempt < max_ifnum; attempt++) {
+		if (quirks & USB_HID_QUIRK_PREFER_LAST_BOOT_INTERFACE)
+			ifnum = max_ifnum - attempt - 1;
+		else
+			ifnum = attempt;
+		if (usb_kbd_probe_dev(dev, ifnum) == 1)
+			break;
+	}
+	if (attempt >= max_ifnum)
 		return -ENOENT;
 
 	/* Register the keyboard */
diff --git a/bl33/v2023/drivers/usb/host/usb-uclass.c b/bl33/v2023/drivers/usb/host/usb-uclass.c
index 060f3441df0cda3babd1556f29e5f62745101208..c6412b004576e1fa335a9c4adfdc87c2e89888e1 100644
--- a/bl33/v2023/drivers/usb/host/usb-uclass.c
+++ b/bl33/v2023/drivers/usb/host/usb-uclass.c
@@ -552,6 +552,7 @@ static int usb_find_and_bind_driver(struct udevice *parent,
 				    struct usb_device_descriptor *desc,
 				    struct usb_interface_descriptor *iface,
 				    int bus_seq, int devnum, int port,
+				    bool bind_generic,
 				    struct udevice **devp)
 {
 	struct usb_driver_entry *start, *entry;
@@ -595,6 +596,10 @@ static int usb_find_and_bind_driver(struct udevice *parent,
 			return 0;
 		}
 	}
+	if (!bind_generic) {
+		ret = -ENOENT;
+		goto error;
+	}
 
 	/* Bind a generic driver so that the device can be used */
 	snprintf(name, sizeof(name), "generic_bus_%x_dev_%x", bus_seq, devnum);
@@ -648,9 +653,9 @@ int usb_scan_device(struct udevice *parent, int port,
 	struct usb_dev_plat *plat;
 	struct usb_bus_priv *priv;
 	struct usb_device *parent_udev;
-	int ret;
+	int ifnum, max_ifnum, ret;
 	ALLOC_CACHE_ALIGN_BUFFER(struct usb_device, udev, 1);
-	struct usb_interface_descriptor *iface = &udev->config.if_desc[0].desc;
+	struct usb_interface_descriptor *iface;
 
 	*devp = NULL;
 	memset(udev, '\0', sizeof(*udev));
@@ -696,15 +701,36 @@ int usb_scan_device(struct udevice *parent, int port,
 	debug("read_descriptor for '%s': ret=%d\n", parent->name, ret);
 	if (ret)
 		return ret;
-	ret = usb_find_child(parent, &udev->descriptor, iface, &dev);
-	debug("** usb_find_child returns %d\n", ret);
-	if (ret) {
+	max_ifnum = min((int)USB_MAX_ACTIVE_INTERFACES,
+			(int)udev->config.no_of_if);
+
+	for (ifnum = 0; ifnum < max_ifnum; ifnum++) {
+		iface = &udev->config.if_desc[ifnum].desc;
+		ret = usb_find_child(parent, &udev->descriptor, iface, &dev);
+		debug("** usb_find_child interface %d returns %d\n",
+		      ifnum, ret);
+		if (!ret)
+			break;
 		if (ret != -ENOENT)
 			return ret;
 		ret = usb_find_and_bind_driver(parent, &udev->descriptor,
 					       iface,
 					       dev_seq(udev->controller_dev),
-					       udev->devnum, port, &dev);
+					       udev->devnum, port, false, &dev);
+		if (!ret) {
+			created = true;
+			break;
+		}
+		if (ret != -ENOENT)
+			return ret;
+	}
+
+	if (ifnum == max_ifnum) {
+		iface = &udev->config.if_desc[0].desc;
+		ret = usb_find_and_bind_driver(parent, &udev->descriptor,
+					       iface,
+					       dev_seq(udev->controller_dev),
+					       udev->devnum, port, true, &dev);
 		if (ret)
 			return ret;
 		created = true;
diff --git a/bl33/v2023/drivers/usb/host/xhci.c b/bl33/v2023/drivers/usb/host/xhci.c
index 7082f071a37c6d8cc245fa014cef13bc23a4ebd7..e670cdb4d66ccd601d6deb33270576a7db73a0a1 100644
--- a/bl33/v2023/drivers/usb/host/xhci.c
+++ b/bl33/v2023/drivers/usb/host/xhci.c
@@ -530,67 +530,33 @@ static int xhci_configure_endpoints(struct usb_device *udev, bool ctx_change)
 }
 
 /**
- * Configure the endpoint, programming the device contexts.
+ * Fill endpoint contexts for interface descriptor ifdesc.
  *
- * @param udev	pointer to the USB device structure
- * Return: returns the status of the xhci_configure_endpoints
+ * @param udev		pointer to the USB device structure
+ * @param ctrl		pointer to the xhci private device structure
+ * @param virt_dev	pointer to the xhci virtual device structure
+ * @param ifdesc	pointer to the USB interface config descriptor
+ * Return: returns the status of xhci_init_ep_contexts_if
  */
-static int xhci_set_configuration(struct usb_device *udev)
+static int xhci_init_ep_contexts_if(struct usb_device *udev,
+				    struct xhci_ctrl *ctrl,
+				    struct xhci_virt_device *virt_dev,
+				    struct usb_interface *ifdesc)
 {
-	struct xhci_container_ctx *in_ctx;
-	struct xhci_container_ctx *out_ctx;
-	struct xhci_input_control_ctx *ctrl_ctx;
-	struct xhci_slot_ctx *slot_ctx;
 	struct xhci_ep_ctx *ep_ctx[MAX_EP_CTX_NUM];
 	int cur_ep;
-	int max_ep_flag = 0;
 	int ep_index;
 	unsigned int dir;
 	unsigned int ep_type;
-	struct xhci_ctrl *ctrl = xhci_get_ctrl(udev);
-	int num_of_ep;
-	int ep_flag = 0;
 	u64 trb_64 = 0;
-	int slot_id = udev->slot_id;
-	struct xhci_virt_device *virt_dev = ctrl->devs[slot_id];
-	struct usb_interface *ifdesc;
 	u32 max_esit_payload;
 	unsigned int interval;
 	unsigned int mult;
 	unsigned int max_burst;
 	unsigned int avg_trb_len;
 	unsigned int err_count = 0;
+	int num_of_ep = ifdesc->no_of_ep;
 
-	out_ctx = virt_dev->out_ctx;
-	in_ctx = virt_dev->in_ctx;
-
-	num_of_ep = udev->config.if_desc[0].no_of_ep;
-	ifdesc = &udev->config.if_desc[0];
-
-	ctrl_ctx = xhci_get_input_control_ctx(in_ctx);
-	/* Initialize the input context control */
-	ctrl_ctx->add_flags = cpu_to_le32(SLOT_FLAG);
-	ctrl_ctx->drop_flags = 0;
-
-	/* EP_FLAG gives values 1 & 4 for EP1OUT and EP2IN */
-	for (cur_ep = 0; cur_ep < num_of_ep; cur_ep++) {
-		ep_flag = xhci_get_ep_index(&ifdesc->ep_desc[cur_ep]);
-		ctrl_ctx->add_flags |= cpu_to_le32(1 << (ep_flag + 1));
-		if (max_ep_flag < ep_flag)
-			max_ep_flag = ep_flag;
-	}
-
-	xhci_inval_cache((uintptr_t)out_ctx->bytes, out_ctx->size);
-
-	/* slot context */
-	xhci_slot_copy(ctrl, in_ctx, out_ctx);
-	slot_ctx = xhci_get_slot_ctx(ctrl, in_ctx);
-	slot_ctx->dev_info &= ~(cpu_to_le32(LAST_CTX_MASK));
-	slot_ctx->dev_info |= cpu_to_le32(LAST_CTX(max_ep_flag + 1) | 0);
-
-	xhci_endpoint_copy(ctrl, in_ctx, out_ctx, 0);
-
-	/* filling up ep contexts */
 	for (cur_ep = 0; cur_ep < num_of_ep; cur_ep++) {
 		struct usb_endpoint_descriptor *endpt_desc = NULL;
 		struct usb_ss_ep_comp_descriptor *ss_ep_comp_desc = NULL;
@@ -616,7 +582,8 @@ static int xhci_set_configuration(struct usb_device *udev)
 		avg_trb_len = max_esit_payload;
 
 		ep_index = xhci_get_ep_index(endpt_desc);
-		ep_ctx[ep_index] = xhci_get_ep_ctx(ctrl, in_ctx, ep_index);
+		ep_ctx[ep_index] = xhci_get_ep_ctx(ctrl, virt_dev->in_ctx,
+						   ep_index);
 
 		/* Allocate the ep rings */
 		virt_dev->eps[ep_index].ring = xhci_ring_alloc(ctrl, 1, true);
@@ -668,6 +635,72 @@ static int xhci_set_configuration(struct usb_device *udev)
 		}
 	}
 
+	return 0;
+}
+
+/**
+ * Configure the endpoint, programming the device contexts.
+ *
+ * @param udev	pointer to the USB device structure
+ * Return: returns the status of the xhci_configure_endpoints
+ */
+static int xhci_set_configuration(struct usb_device *udev)
+{
+	struct xhci_container_ctx *out_ctx;
+	struct xhci_container_ctx *in_ctx;
+	struct xhci_input_control_ctx *ctrl_ctx;
+	struct xhci_slot_ctx *slot_ctx;
+	int err;
+	int cur_ep;
+	int max_ep_flag = 0;
+	struct xhci_ctrl *ctrl = xhci_get_ctrl(udev);
+	int num_of_ep;
+	int ep_flag = 0;
+	int slot_id = udev->slot_id;
+	struct xhci_virt_device *virt_dev = ctrl->devs[slot_id];
+	struct usb_interface *ifdesc;
+	unsigned int ifnum;
+	unsigned int max_ifnum = min((unsigned int)USB_MAX_ACTIVE_INTERFACES,
+				     (unsigned int)udev->config.no_of_if);
+
+	out_ctx = virt_dev->out_ctx;
+	in_ctx = virt_dev->in_ctx;
+
+	ctrl_ctx = xhci_get_input_control_ctx(in_ctx);
+	/* Initialize the input context control */
+	ctrl_ctx->add_flags = cpu_to_le32(SLOT_FLAG);
+	ctrl_ctx->drop_flags = 0;
+
+	for (ifnum = 0; ifnum < max_ifnum; ifnum++) {
+		ifdesc = &udev->config.if_desc[ifnum];
+		num_of_ep = ifdesc->no_of_ep;
+		/* EP_FLAG gives values 1 & 4 for EP1OUT and EP2IN */
+		for (cur_ep = 0; cur_ep < num_of_ep; cur_ep++) {
+			ep_flag = xhci_get_ep_index(&ifdesc->ep_desc[cur_ep]);
+			ctrl_ctx->add_flags |= cpu_to_le32(1 << (ep_flag + 1));
+			if (max_ep_flag < ep_flag)
+				max_ep_flag = ep_flag;
+		}
+	}
+
+	xhci_inval_cache((uintptr_t)out_ctx->bytes, out_ctx->size);
+
+	/* slot context */
+	xhci_slot_copy(ctrl, in_ctx, out_ctx);
+	slot_ctx = xhci_get_slot_ctx(ctrl, in_ctx);
+	slot_ctx->dev_info &= ~(cpu_to_le32(LAST_CTX_MASK));
+	slot_ctx->dev_info |= cpu_to_le32(LAST_CTX(max_ep_flag + 1) | 0);
+
+	xhci_endpoint_copy(ctrl, in_ctx, out_ctx, 0);
+
+	/* filling up ep contexts */
+	for (ifnum = 0; ifnum < max_ifnum; ifnum++) {
+		ifdesc = &udev->config.if_desc[ifnum];
+		err = xhci_init_ep_contexts_if(udev, ctrl, virt_dev, ifdesc);
+		if (err < 0)
+			return err;
+	}
+
 	return xhci_configure_endpoints(udev, false);
 }
 
diff --git a/bl33/v2023/include/usb.h b/bl33/v2023/include/usb.h
index 7e3796bd5baaec665c2bd0687cef81c959d43dd2..92f0cd01ab2c171f643779fa20485ab790d106d3 100644
--- a/bl33/v2023/include/usb.h
+++ b/bl33/v2023/include/usb.h
@@ -46,6 +46,12 @@
  */
 #define USB_TIMEOUT_MS(pipe) (usb_pipebulk(pipe) ? 5000 : 1000)
 
+/*
+ * The xHCI host controller prepares only a limited number of interfaces and
+ * endpoints. Keep this limit visible to drivers that scan composite devices.
+ */
+#define USB_MAX_ACTIVE_INTERFACES	3
+
 /* device request (setup) */
 struct devrequest {
 	__u8	requesttype;

