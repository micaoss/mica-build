+struct cfgload_context {
+	const char *partition;
+};
+
+static int cfgload_select_source(void *context, const char *partition)
+{
+	struct cfgload_context *cfgload = context;
+
+	cfgload->partition = partition;
+	return fs_set_blk_dev("mmc", partition, FS_TYPE_ANY) ? -1 : 0;
+}
+
+static int cfgload_reselect_source(void *context)
+{
+	struct cfgload_context *cfgload = context;
+
+	if (!cfgload->partition)
+		return -1;
+	return fs_set_blk_dev("mmc", cfgload->partition, FS_TYPE_ANY) ? -1 : 0;
+}
+
+static enum cfgload_file_status cfgload_file_size(void *context,
+						  const char *path,
+						  unsigned long *size)
+{
+	loff_t length;
+	int exists;
+
+	if (cfgload_reselect_source(context))
+		return CFGLOAD_FILE_ERROR;
+	exists = fs_exists(path);
+	if (exists < 0)
+		return CFGLOAD_FILE_ERROR;
+	if (!exists)
+		return CFGLOAD_FILE_MISSING;
+	if (cfgload_reselect_source(context))
+		return CFGLOAD_FILE_ERROR;
+	if (fs_size(path, &length) || length < 0)
+		return CFGLOAD_FILE_ERROR;
+
+	*size = length;
+	return CFGLOAD_FILE_OK;
+}
+
+static int cfgload_read_file(void *context, const char *path, void *buffer,
+			     unsigned long size)
+{
+	loff_t actual;
+
+	if (cfgload_reselect_source(context))
+		return -1;
+	if (fs_read(path, map_to_sysmem(buffer), 0, size, &actual))
+		return -1;
+
+	return actual >= 0 && (unsigned long)actual == size ? 0 : -1;
+}
+
+static void *cfgload_allocate(void *context, unsigned long size)
+{
+	(void)context;
+	return malloc(size);
+}
+
+static void cfgload_release(void *context, void *buffer)
+{
+	(void)context;
+	free(buffer);
+}
+
+static int cfgload_set_devnum(void *context, const char *devnum)
+{
+	(void)context;
+	return env_set("cfgload_devnum", devnum);
+}
+
+static int cfgload_execute_script(void *context, char *script,
+				  unsigned long size)
+{
+	char cmd[64];
+
+	(void)context;
+	/* cfgload already validated and removed the boot.ini magic line. */
+	sprintf(cmd, "script %p %lx 1", script, size);
+	return run_command(cmd, 0);
+}
+
+static void cfgload_diagnose(void *context,
+			     const struct cfgload_source *source,
+			     enum cfgload_source_error error,
+			     const char *path, long detail)
+{
+	(void)context;
+	printf("cfgload: %s source (mmc %s): ", source->name,
+	       source->partition);
+
+	switch (error) {
+	case CFGLOAD_SOURCE_CLEAR_FAILED:
+		printf("failed to clear transient cfgload_devnum; no fallback\n");
+		break;
+	case CFGLOAD_SOURCE_SELECT_FAILED:
+		printf("could not select the fixed partition; no fallback\n");
+		break;
+	case CFGLOAD_SOURCE_SCRIPT_STAT_FAILED:
+		printf("failed to inspect %s; no fallback\n", path);
+		break;
+	case CFGLOAD_SOURCE_SCRIPT_MISSING:
+		printf("no non-empty /boot.ini or /boot/boot.ini; no fallback\n");
+		break;
+	case CFGLOAD_SOURCE_SCRIPT_TOO_LARGE:
+		printf("%s is too large (%ld > %lu bytes); no fallback\n",
+		       path, detail, CFGLOAD_BOOTINI_MAX_BYTES);
+		break;
+	case CFGLOAD_SOURCE_SCRIPT_ALLOC_FAILED:
+		printf("could not allocate %ld bytes for %s; no fallback\n",
+		       detail + 1, path);
+		break;
+	case CFGLOAD_SOURCE_SCRIPT_READ_FAILED:
+		printf("failed to read %s completely; no fallback\n", path);
+		break;
+	case CFGLOAD_SOURCE_SCRIPT_MAGIC_INVALID:
+		printf("%s lacks exact magic %s; no fallback\n", path,
+		       CFGLOAD_BOOTINI_MAGIC);
+		break;
+	case CFGLOAD_SOURCE_SCRIPT_BODY_EMPTY:
+		printf("%s has no commands after its magic; no fallback\n", path);
+		break;
+	case CFGLOAD_SOURCE_IMAGE_STAT_FAILED:
+		printf("failed to inspect %s; no fallback\n", path);
+		break;
+	case CFGLOAD_SOURCE_IMAGE_MISSING:
+		printf("%s is missing or empty; no fallback\n", path);
+		break;
+	case CFGLOAD_SOURCE_OVERRIDE_FAILED:
+		printf("failed to set the validated cfgload_devnum for %s; no fallback\n",
+		       path);
+		break;
+	case CFGLOAD_SOURCE_SCRIPT_FAILED:
+		printf("%s returned status %ld; no fallback\n", path, detail);
+		break;
+	}
+}
+
+static int read_cfgload_source(const struct cfgload_source *source)
+{
+	struct cfgload_context context = { 0 };
+	const struct cfgload_source_ops ops = {
+		.select = cfgload_select_source,
+		.file_size = cfgload_file_size,
+		.read = cfgload_read_file,
+		.allocate = cfgload_allocate,
+		.release = cfgload_release,
+		.set_devnum = cfgload_set_devnum,
+		.execute = cfgload_execute_script,
+		.diagnose = cfgload_diagnose,
+	};
+
+	printf("cfgload: strict %s source selected (mmc %s)\n",
+	       source->name, source->partition);
+	return cfgload_source_run(&ops, &context, source);
+}
+
