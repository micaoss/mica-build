+// SPDX-License-Identifier: GPL-2.0+
+/* Runtime Linux source policy for BM201. */
+
+#include <ansi.h>
+#include <common.h>
+#include <command.h>
+#include <env.h>
+#include <fs.h>
+#include <stdio_dev.h>
+
+#include "boot_source_logic.h"
+
+static int bm201_route_serial(void *context)
+{
+	int status;
+
+	(void)context;
+	status = env_set("stdout", BM201_CONSOLE_SERIAL);
+	status |= env_set("stderr", BM201_CONSOLE_SERIAL);
+	return status;
+}
+
+static int bm201_run_installer(void *context)
+{
+	(void)context;
+	return run_command("bm201_emmc_update", 0);
+}
+
+static int bm201_sd_image_present(void *context)
+{
+	loff_t size;
+
+	(void)context;
+	if (fs_set_blk_dev("mmc", "0:1", FS_TYPE_ANY))
+		return 0;
+	if (fs_size("/Image", &size) || size <= 0)
+		return 0;
+
+	return 1;
+}
+
+static int bm201_run_cfgload(void *context, enum bm201_linux_source source)
+{
+	(void)context;
+	return run_command(source == BM201_LINUX_SOURCE_SD ?
+			   "cfgload sd" : "cfgload emmc", 0);
+}
+
+static int bm201_restore_console(void *context)
+{
+	const char *output = env_get("bm201_console_out");
+	int video_output;
+	int status;
+
+	(void)context;
+	if (!bm201_logic_streq(output, BM201_CONSOLE_SERIAL) &&
+	    !bm201_logic_streq(output, BM201_CONSOLE_VIDEO))
+		output = BM201_CONSOLE_SERIAL;
+	video_output = bm201_logic_streq(output, BM201_CONSOLE_VIDEO);
+	if (video_output && !stdio_get_by_name("vidconsole")) {
+		output = BM201_CONSOLE_SERIAL;
+		video_output = 0;
+	}
+
+	status = env_set("stdout", output);
+	status |= env_set("stderr", output);
+	if (status && !bm201_logic_streq(output, BM201_CONSOLE_SERIAL)) {
+		env_set("stdout", BM201_CONSOLE_SERIAL);
+		env_set("stderr", BM201_CONSOLE_SERIAL);
+	}
+	if (!status && video_output)
+		status = run_command("cls", 0);
+	puts(ANSI_CURSOR_SHOW);
+
+	return status;
+}
+
+static const char *bm201_source_name(enum bm201_linux_source source)
+{
+	return source == BM201_LINUX_SOURCE_SD ? "SD" : "eMMC";
+}
+
+static int do_bm201_boot_source(struct cmd_tbl *cmdtp, int flag, int argc,
+				char *const argv[])
+{
+	const struct bm201_boot_source_ops ops = {
+		.route_serial = bm201_route_serial,
+		.run_installer = bm201_run_installer,
+		.sd_image_present = bm201_sd_image_present,
+		.run_cfgload = bm201_run_cfgload,
+		.restore_console = bm201_restore_console,
+	};
+	struct bm201_boot_source_outcome outcome;
+	enum bm201_boot_source_result result;
+
+	if (argc != 2)
+		return CMD_RET_USAGE;
+
+	result = bm201_boot_source_run(&ops, NULL, argv[1], &outcome);
+	if (result == BM201_BOOT_SOURCE_INVALID)
+		return CMD_RET_USAGE;
+
+	if (outcome.restore_status)
+		printf("BM201 boot source: recovery console restore failed (%d)\n",
+		       outcome.restore_status);
+
+	switch (result) {
+	case BM201_BOOT_SOURCE_ROUTE_FAILED:
+		printf("BM201 boot source: serial output routing failed (%d); installer not started\n",
+		       outcome.route_status);
+		break;
+	case BM201_BOOT_SOURCE_INSTALLER_FAILED:
+		printf("BM201 boot source: installer gate failed (%d); Linux boot stopped\n",
+		       outcome.installer_status);
+		break;
+	case BM201_BOOT_SOURCE_CFGLOAD_FAILED:
+		printf("BM201 boot source: %s Linux boot failed (%d); returned to recovery\n",
+		       bm201_source_name(outcome.source), outcome.cfgload_status);
+		break;
+	case BM201_BOOT_SOURCE_RETURNED:
+		printf("BM201 boot source: %s Linux boot returned unexpectedly; returned to recovery\n",
+		       bm201_source_name(outcome.source));
+		break;
+	case BM201_BOOT_SOURCE_INVALID:
+		break;
+	}
+
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(bm201_boot_source, 2, 0, do_bm201_boot_source,
+	   "run the BM201 installer gate and boot one Linux source",
+	   "auto|sd|emmc"
+);
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/boot_source_logic.h b/bl33/v2023/board/amlogic/s7d_bm201/boot_source_logic.h
new file mode 100644
index 00000000..9100511c
--- /dev/null
+++ b/bl33/v2023/board/amlogic/s7d_bm201/boot_source_logic.h
@@ -0,0 +1,220 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef __BM201_BOOT_SOURCE_LOGIC_H__
+#define __BM201_BOOT_SOURCE_LOGIC_H__
+
+#define BM201_CONSOLE_SERIAL		"serial"
+#define BM201_CONSOLE_VIDEO		"serial,vidconsole"
+#define BM201_BOOTMENU_AUTOMATIC	"Automatic boot=bm201_boot_source auto"
+#define BM201_BOOTMENU_SD		"Boot Linux from SD=bm201_boot_source sd"
+#define BM201_BOOTMENU_EMMC		"Boot Linux from eMMC=bm201_boot_source emmc"
+#define BM201_BOOTMENU_COMMAND		"bootmenu 3"
+
+int s7d_bm201_osd_video_prepare(void);
+
+enum bm201_linux_source {
+	BM201_LINUX_SOURCE_NONE = 0,
+	BM201_LINUX_SOURCE_SD,
+	BM201_LINUX_SOURCE_EMMC,
+};
+
+enum bm201_boot_source_result {
+	BM201_BOOT_SOURCE_INVALID = 0,
+	BM201_BOOT_SOURCE_ROUTE_FAILED,
+	BM201_BOOT_SOURCE_INSTALLER_FAILED,
+	BM201_BOOT_SOURCE_CFGLOAD_FAILED,
+	BM201_BOOT_SOURCE_RETURNED,
+};
+
+struct bm201_boot_source_outcome {
+	enum bm201_linux_source source;
+	int route_status;
+	int installer_status;
+	int sd_image_status;
+	int cfgload_status;
+	int restore_status;
+};
+
+struct bm201_boot_source_ops {
+	int (*route_serial)(void *context);
+	int (*run_installer)(void *context);
+	int (*sd_image_present)(void *context);
+	int (*run_cfgload)(void *context, enum bm201_linux_source source);
+	int (*restore_console)(void *context);
+};
+
+struct bm201_menu_env_ops {
+	int (*set)(void *context, const char *name, const char *value);
+};
+
+enum bm201_menu_setup_result {
+	BM201_MENU_SETUP_OK = 0,
+	BM201_MENU_SETUP_SAFE_FAILED,
+	BM201_MENU_SETUP_POLICY_FAILED,
+};
+
+struct bm201_menu_setup_outcome {
+	const char *failed_name;
+	int failed_status;
+};
+
+static inline int bm201_logic_streq(const char *left, const char *right)
+{
+	if (!left || !right)
+		return 0;
+
+	while (*left && *left == *right) {
+		left++;
+		right++;
+	}
+
+	return *left == *right;
+}
+
+static inline enum bm201_linux_source
+bm201_boot_source_parse(const char *token, int *automatic)
+{
+	*automatic = 0;
+	if (bm201_logic_streq(token, "auto")) {
+		*automatic = 1;
+		return BM201_LINUX_SOURCE_NONE;
+	}
+	if (bm201_logic_streq(token, "sd"))
+		return BM201_LINUX_SOURCE_SD;
+	if (bm201_logic_streq(token, "emmc"))
+		return BM201_LINUX_SOURCE_EMMC;
+
+	return BM201_LINUX_SOURCE_NONE;
+}
+
+static inline enum bm201_boot_source_result
+bm201_boot_source_run(const struct bm201_boot_source_ops *ops,
+		      void *context, const char *token,
+		      struct bm201_boot_source_outcome *outcome)
+{
+	enum bm201_linux_source source;
+	int automatic;
+
+	outcome->source = BM201_LINUX_SOURCE_NONE;
+	outcome->route_status = 0;
+	outcome->installer_status = 0;
+	outcome->sd_image_status = 0;
+	outcome->cfgload_status = 0;
+	outcome->restore_status = 0;
+
+	source = bm201_boot_source_parse(token, &automatic);
+	if (source == BM201_LINUX_SOURCE_NONE && !automatic)
+		return BM201_BOOT_SOURCE_INVALID;
+
+	outcome->route_status = ops->route_serial(context);
+	if (outcome->route_status) {
+		outcome->restore_status = ops->restore_console(context);
+		return BM201_BOOT_SOURCE_ROUTE_FAILED;
+	}
+
+	outcome->installer_status = ops->run_installer(context);
+	if (outcome->installer_status) {
+		outcome->restore_status = ops->restore_console(context);
+		return BM201_BOOT_SOURCE_INSTALLER_FAILED;
+	}
+
+	if (automatic) {
+		outcome->sd_image_status = ops->sd_image_present(context);
+		source = outcome->sd_image_status > 0 ? BM201_LINUX_SOURCE_SD :
+			 BM201_LINUX_SOURCE_EMMC;
+	}
+	outcome->source = source;
+	outcome->cfgload_status = ops->run_cfgload(context, source);
+	outcome->restore_status = ops->restore_console(context);
+
+	return outcome->cfgload_status ? BM201_BOOT_SOURCE_CFGLOAD_FAILED :
+		BM201_BOOT_SOURCE_RETURNED;
+}
+
+static inline void
+bm201_menu_record_failure(struct bm201_menu_setup_outcome *outcome,
+			  const char *name, int status)
+{
+	if (!outcome->failed_name && status) {
+		outcome->failed_name = name;
+		outcome->failed_status = status;
+	}
+}
+
+static inline enum bm201_menu_setup_result
+bm201_menu_setup(const struct bm201_menu_env_ops *ops, void *context,
+		 struct bm201_menu_setup_outcome *outcome)
+{
+	int status;
+
+	outcome->failed_name = 0;
+	outcome->failed_status = 0;
+
+	status = ops->set(context, "stdin", BM201_CONSOLE_SERIAL);
+	bm201_menu_record_failure(outcome, "stdin", status);
+	status = ops->set(context, "stdout", BM201_CONSOLE_SERIAL);
+	bm201_menu_record_failure(outcome, "stdout", status);
+	status = ops->set(context, "stderr", BM201_CONSOLE_SERIAL);
+	bm201_menu_record_failure(outcome, "stderr", status);
+
+	status = ops->set(context, "bootdelay", "-1");
+	bm201_menu_record_failure(outcome, "bootdelay", status);
+	status = ops->set(context, "bootcmd", "");
+	bm201_menu_record_failure(outcome, "bootcmd", status);
+	if (outcome->failed_name)
+		return BM201_MENU_SETUP_SAFE_FAILED;
+
+	status = ops->set(context, "bm201_console_out", BM201_CONSOLE_SERIAL);
+	if (status) {
+		outcome->failed_name = "bm201_console_out";
+		goto policy_failed;
+	}
+	status = ops->set(context, "cfgload_devnum", 0);
+	if (status) {
+		outcome->failed_name = "cfgload_devnum";
+		goto policy_failed;
+	}
+	status = ops->set(context, "bootmenu_0", BM201_BOOTMENU_AUTOMATIC);
+	if (status) {
+		outcome->failed_name = "bootmenu_0";
+		goto policy_failed;
+	}
+	status = ops->set(context, "bootmenu_1", BM201_BOOTMENU_SD);
+	if (status) {
+		outcome->failed_name = "bootmenu_1";
+		goto policy_failed;
+	}
+	status = ops->set(context, "bootmenu_2", BM201_BOOTMENU_EMMC);
+	if (status) {
+		outcome->failed_name = "bootmenu_2";
+		goto policy_failed;
+	}
+	status = ops->set(context, "bootmenu_3", 0);
+	if (status) {
+		outcome->failed_name = "bootmenu_3";
+		goto policy_failed;
+	}
+	status = ops->set(context, "bootmenu_default", "0");
+	if (status) {
+		outcome->failed_name = "bootmenu_default";
+		goto policy_failed;
+	}
+	status = ops->set(context, "bootcmd", BM201_BOOTMENU_COMMAND);
+	if (status) {
+		outcome->failed_name = "bootcmd";
+		goto policy_failed;
+	}
+
+	return BM201_MENU_SETUP_OK;
+
+policy_failed:
+	outcome->failed_status = status;
+	return BM201_MENU_SETUP_POLICY_FAILED;
+}
+
+static inline int bm201_menu_activate(const struct bm201_menu_env_ops *ops,
+				      void *context)
+{
+	return ops->set(context, "bootdelay", "-2");
+}
+
+#endif
