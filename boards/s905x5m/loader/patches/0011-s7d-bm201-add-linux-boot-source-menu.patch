diff --git a/bl33/v2023/cmd/cfgload_logic.h b/bl33/v2023/cmd/cfgload_logic.h
new file mode 100644
index 00000000..a600a1d5
--- /dev/null
+++ b/bl33/v2023/cmd/cfgload_logic.h
@@ -0,0 +1,255 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef __CFGLOAD_LOGIC_H__
+#define __CFGLOAD_LOGIC_H__
+
+#define CFGLOAD_BOOTINI_MAGIC		"ODROIDC5-UBOOT-CONFIG"
+#define CFGLOAD_BOOTINI_MAX_BYTES	(64UL * 1024UL)
+#define CFGLOAD_SCRIPT_PATH_COUNT	2
+
+enum cfgload_file_status {
+	CFGLOAD_FILE_OK = 0,
+	CFGLOAD_FILE_MISSING,
+	CFGLOAD_FILE_ERROR,
+};
+
+enum cfgload_source_error {
+	CFGLOAD_SOURCE_CLEAR_FAILED = 0,
+	CFGLOAD_SOURCE_SELECT_FAILED,
+	CFGLOAD_SOURCE_SCRIPT_STAT_FAILED,
+	CFGLOAD_SOURCE_SCRIPT_MISSING,
+	CFGLOAD_SOURCE_SCRIPT_TOO_LARGE,
+	CFGLOAD_SOURCE_SCRIPT_ALLOC_FAILED,
+	CFGLOAD_SOURCE_SCRIPT_READ_FAILED,
+	CFGLOAD_SOURCE_SCRIPT_MAGIC_INVALID,
+	CFGLOAD_SOURCE_SCRIPT_BODY_EMPTY,
+	CFGLOAD_SOURCE_IMAGE_STAT_FAILED,
+	CFGLOAD_SOURCE_IMAGE_MISSING,
+	CFGLOAD_SOURCE_OVERRIDE_FAILED,
+	CFGLOAD_SOURCE_SCRIPT_FAILED,
+};
+
+struct cfgload_source {
+	const char *name;
+	const char *partition;
+	const char *devnum;
+};
+
+struct cfgload_source_ops {
+	int (*select)(void *context, const char *partition);
+	enum cfgload_file_status (*file_size)(void *context,
+					      const char *path, unsigned long *size);
+	int (*read)(void *context, const char *path, void *buffer,
+		    unsigned long size);
+	void *(*allocate)(void *context, unsigned long size);
+	void (*release)(void *context, void *buffer);
+	int (*set_devnum)(void *context, const char *devnum);
+	int (*execute)(void *context, char *script, unsigned long size);
+	void (*diagnose)(void *context, const struct cfgload_source *source,
+			 enum cfgload_source_error error, const char *path,
+			 long detail);
+};
+
+static inline int cfgload_logic_isblank(char c)
+{
+	return c == ' ' || c == '\t';
+}
+
+static inline int cfgload_logic_isalnum(char c)
+{
+	return (c >= '0' && c <= '9') ||
+	       (c >= 'A' && c <= 'Z') ||
+	       (c >= 'a' && c <= 'z');
+}
+
+static inline int cfgload_logic_ispunct(char c)
+{
+	return c >= '!' && c <= '~' && !cfgload_logic_isalnum(c);
+}
+
+static inline int cfgload_logic_valid_command(const char *line)
+{
+	const char *cursor;
+
+	for (cursor = line; *cursor; cursor++) {
+		if (cfgload_logic_isblank(*cursor))
+			continue;
+		if (cfgload_logic_isalnum(*cursor))
+			return 1;
+		if (cfgload_logic_ispunct(*cursor))
+			return *cursor != '#' && *cursor != ';';
+	}
+
+	return line != cursor;
+}
+
+static inline int cfgload_logic_streq(const char *left, const char *right)
+{
+	while (*left && *left == *right) {
+		left++;
+		right++;
+	}
+
+	return *left == *right;
+}
+
+static inline unsigned long cfgload_logic_strlen(const char *string)
+{
+	const char *end = string;
+
+	while (*end)
+		end++;
+
+	return end - string;
+}
+
+static inline char *cfgload_logic_script_body(char *buffer)
+{
+	char *cursor = buffer;
+
+	while (*cursor) {
+		char *line = cursor;
+
+		while (*cursor && *cursor != '\n')
+			cursor++;
+		if (*cursor == '\n') {
+			*cursor = '\0';
+			cursor++;
+		}
+
+		if (!cfgload_logic_valid_command(line))
+			continue;
+		if (cfgload_logic_streq(line, CFGLOAD_BOOTINI_MAGIC))
+			return cursor;
+	}
+
+	return 0;
+}
+
+static inline int cfgload_source_run(const struct cfgload_source_ops *ops,
+				     void *context,
+				     const struct cfgload_source *source)
+{
+	static const char *const script_paths[] = {
+		"/boot.ini",
+		"/boot/boot.ini",
+	};
+	enum cfgload_file_status status;
+	unsigned long script_size = 0;
+	unsigned long image_size = 0;
+	unsigned long body_size;
+	const char *script_path = 0;
+	char *buffer = 0;
+	char *body;
+	int command_status;
+	int clear_status;
+	unsigned int index;
+
+	if (ops->set_devnum(context, 0)) {
+		ops->diagnose(context, source, CFGLOAD_SOURCE_CLEAR_FAILED, 0, 0);
+		return -1;
+	}
+
+	if (ops->select(context, source->partition)) {
+		ops->diagnose(context, source, CFGLOAD_SOURCE_SELECT_FAILED, 0, 0);
+		goto fail;
+	}
+
+	for (index = 0; index < CFGLOAD_SCRIPT_PATH_COUNT; index++) {
+		status = ops->file_size(context, script_paths[index],
+					&script_size);
+		if (status == CFGLOAD_FILE_MISSING ||
+		    (status == CFGLOAD_FILE_OK && !script_size))
+			continue;
+		if (status != CFGLOAD_FILE_OK) {
+			ops->diagnose(context, source,
+				      CFGLOAD_SOURCE_SCRIPT_STAT_FAILED,
+				      script_paths[index], 0);
+			goto fail;
+		}
+		if (script_size > CFGLOAD_BOOTINI_MAX_BYTES) {
+			ops->diagnose(context, source,
+				      CFGLOAD_SOURCE_SCRIPT_TOO_LARGE,
+				      script_paths[index], script_size);
+			goto fail;
+		}
+
+		buffer = ops->allocate(context, script_size + 1);
+		if (!buffer) {
+			ops->diagnose(context, source,
+				      CFGLOAD_SOURCE_SCRIPT_ALLOC_FAILED,
+				      script_paths[index], script_size);
+			goto fail;
+		}
+		if (ops->read(context, script_paths[index], buffer, script_size)) {
+			ops->diagnose(context, source,
+				      CFGLOAD_SOURCE_SCRIPT_READ_FAILED,
+				      script_paths[index], 0);
+			goto fail;
+		}
+
+		buffer[script_size] = '\0';
+		script_path = script_paths[index];
+		break;
+	}
+
+	if (!buffer) {
+		ops->diagnose(context, source, CFGLOAD_SOURCE_SCRIPT_MISSING, 0, 0);
+		goto fail;
+	}
+
+	body = cfgload_logic_script_body(buffer);
+	if (!body) {
+		ops->diagnose(context, source,
+			      CFGLOAD_SOURCE_SCRIPT_MAGIC_INVALID,
+			      script_path, 0);
+		goto fail;
+	}
+	body_size = cfgload_logic_strlen(body);
+	if (!body_size) {
+		ops->diagnose(context, source, CFGLOAD_SOURCE_SCRIPT_BODY_EMPTY,
+			      script_path, 0);
+		goto fail;
+	}
+
+	status = ops->file_size(context, "/Image", &image_size);
+	if (status == CFGLOAD_FILE_ERROR) {
+		ops->diagnose(context, source,
+			      CFGLOAD_SOURCE_IMAGE_STAT_FAILED, "/Image", 0);
+		goto fail;
+	}
+	if (status != CFGLOAD_FILE_OK || !image_size) {
+		ops->diagnose(context, source, CFGLOAD_SOURCE_IMAGE_MISSING,
+			      "/Image", 0);
+		goto fail;
+	}
+
+	if (ops->set_devnum(context, source->devnum)) {
+		ops->diagnose(context, source, CFGLOAD_SOURCE_OVERRIDE_FAILED,
+			      script_path, 0);
+		goto fail;
+	}
+
+	command_status = ops->execute(context, body, body_size);
+	clear_status = ops->set_devnum(context, 0);
+	ops->release(context, buffer);
+
+	if (command_status) {
+		ops->diagnose(context, source, CFGLOAD_SOURCE_SCRIPT_FAILED,
+			      script_path, command_status);
+		return -1;
+	}
+	if (clear_status) {
+		ops->diagnose(context, source, CFGLOAD_SOURCE_CLEAR_FAILED, 0, 0);
+		return -1;
+	}
+
+	return 0;
+
+fail:
+	ops->set_devnum(context, 0);
+	if (buffer)
+		ops->release(context, buffer);
+	return -1;
+}
+
+#endif
