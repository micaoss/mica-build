From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Builder <builder@example.invalid>
Date: Thu, 27 Aug 2026 03:00:00 +0000
Subject: [PATCH] s7d: make the BM201 eMMC installer reusable

Keep the v2 request on the SD card and identify the package with a fixed
lowercase SHA-256 file. Skip a target carrying an exact matching receipt.

Treat only a zero sdc_burn return as success, then write and verify the receipt
on the eMMC boot FAT partition before issuing the wrapper-controlled reset.
Every other outcome stops normal boot except an absent request or matching
receipt.
---
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer.c b/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer.c
index 2d41241..706290c 100644
--- a/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer.c
+++ b/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer.c
@@ -13,44 +13,59 @@ struct bm201_installer_context {
 	unsigned long long package_size;
 };
 
-static int bm201_installer_file_size(void *opaque, const char *path,
-				     unsigned long long *size)
+static int bm201_installer_select_sd(void *opaque)
+{
+	(void)opaque;
+	return fs_set_blk_dev(BM201_INSTALLER_BLOCK_INTERFACE,
+			      BM201_INSTALLER_SD_DEVICE, FS_TYPE_FAT) ? -1 : 0;
+}
+
+static int bm201_installer_select_emmc(void *opaque)
+{
+	(void)opaque;
+	return fs_set_blk_dev(BM201_INSTALLER_BLOCK_INTERFACE,
+			      BM201_INSTALLER_EMMC_DEVICE, FS_TYPE_FAT) ? -1 : 0;
+}
+
+static enum bm201_installer_file_status
+bm201_installer_file_size(void *opaque, const char *path,
+			  unsigned long long *size)
 {
 	struct bm201_installer_context *context = opaque;
 	loff_t length;
+	int exists;
 
-	if (fs_set_blk_dev("mmc", "0:1", FS_TYPE_FAT))
-		return -1;
+	exists = fs_exists(path);
+	if (exists < 0)
+		return BM201_INSTALLER_FILE_ERROR;
+	if (!exists)
+		return BM201_INSTALLER_FILE_MISSING;
 	if (fs_size(path, &length) || length < 0)
-		return -1;
+		return BM201_INSTALLER_FILE_ERROR;
 
 	*size = length;
 	if (!strcmp(path, BM201_INSTALLER_PACKAGE))
 		context->package_size = length;
-	return 0;
+	return BM201_INSTALLER_FILE_OK;
 }
 
 static int bm201_installer_read_file(void *opaque, const char *path,
-                                    void *buffer, unsigned int length)
+				      void *buffer, unsigned int length)
 {
 	loff_t actual;
 
 	(void)opaque;
-	if (fs_set_blk_dev("mmc", "0:1", FS_TYPE_FAT))
-		return -1;
 	if (fs_read(path, map_to_sysmem(buffer), 0, length, &actual))
 		return -1;
 	return actual == length ? 0 : -1;
 }
 
 static int bm201_installer_write_file(void *opaque, const char *path,
-                                     const void *buffer, unsigned int length)
+				       const void *buffer, unsigned int length)
 {
 	loff_t actual;
 
 	(void)opaque;
-	if (fs_set_blk_dev("mmc", "0:1", FS_TYPE_FAT))
-		return -1;
 	if (fs_write(path, map_to_sysmem(buffer), 0, length, &actual))
 		return -1;
 	return actual == length ? 0 : -1;
@@ -62,7 +77,7 @@ static int bm201_installer_burn(void *opaque)
 
 	printf("eMMC installer: prerequisites verified, package %llu bytes\n",
 	       context->package_size);
-	printf("eMMC installer: one-shot marker consumed; starting sdc_burn\n");
+	printf("eMMC installer: starting sdc_burn\n");
 	if (env_set("sdcburncfg", BM201_INSTALLER_CONFIG)) {
 		printf("eMMC installer: failed to select the fixed burn configuration\n");
 		return -1;
@@ -71,15 +86,25 @@ static int bm201_installer_burn(void *opaque)
 	return run_command("sdc_burn " BM201_INSTALLER_CONFIG, 0);
 }
 
+static void bm201_installer_reset(void *opaque)
+{
+	(void)opaque;
+	printf("eMMC installer: installation complete; receipt verified; resetting\n");
+	run_command("reset", 0);
+}
+
 static int do_bm201_emmc_update(struct cmd_tbl *cmdtp, int flag, int argc,
 				char *const argv[])
 {
 	struct bm201_installer_context context = { 0 };
 	const struct bm201_installer_ops ops = {
+		.select_sd = bm201_installer_select_sd,
+		.select_emmc = bm201_installer_select_emmc,
 		.file_size = bm201_installer_file_size,
 		.read_file = bm201_installer_read_file,
 		.write_file = bm201_installer_write_file,
 		.burn = bm201_installer_burn,
+		.reset = bm201_installer_reset,
 	};
 	enum bm201_installer_result result;
 
@@ -92,19 +117,92 @@ static int do_bm201_emmc_update(struct cmd_tbl *cmdtp, int flag, int argc,
 	switch (result) {
 	case BM201_INSTALLER_NO_REQUEST:
 		return CMD_RET_SUCCESS;
-	case BM201_INSTALLER_MARKER_INVALID:
+	case BM201_INSTALLER_ALREADY_INSTALLED:
+		printf("eMMC installer: %s matches %s; skipping installation\n",
+		       BM201_INSTALLER_RECEIPT_FILE,
+		       BM201_INSTALLER_IDENTITY_FILE);
+		return CMD_RET_SUCCESS;
+	case BM201_INSTALLER_REQUEST_SD_SELECT_FAILED:
+		printf("eMMC installer: failed to select SD FAT %s %s\n",
+		       BM201_INSTALLER_BLOCK_INTERFACE,
+		       BM201_INSTALLER_SD_DEVICE);
+		break;
+	case BM201_INSTALLER_REQUEST_STAT_FAILED:
+		printf("eMMC installer: failed to inspect %s\n",
+		       BM201_INSTALLER_REQUEST_FILE);
+		break;
+	case BM201_INSTALLER_REQUEST_LENGTH_INVALID:
+		printf("eMMC installer: %s has the wrong request length\n",
+		       BM201_INSTALLER_REQUEST_FILE);
+		break;
+	case BM201_INSTALLER_REQUEST_READ_FAILED:
+		printf("eMMC installer: failed to read %s\n",
+		       BM201_INSTALLER_REQUEST_FILE);
+		break;
+	case BM201_INSTALLER_REQUEST_CONTENT_INVALID:
 		printf("eMMC installer: %s does not contain the exact request\n",
-		       BM201_INSTALLER_MARKER);
+		       BM201_INSTALLER_REQUEST_FILE);
+		break;
+	case BM201_INSTALLER_IDENTITY_MISSING:
+		printf("eMMC installer: %s is missing\n",
+		       BM201_INSTALLER_IDENTITY_FILE);
+		break;
+	case BM201_INSTALLER_IDENTITY_STAT_FAILED:
+		printf("eMMC installer: failed to inspect %s\n",
+		       BM201_INSTALLER_IDENTITY_FILE);
+		break;
+	case BM201_INSTALLER_IDENTITY_LENGTH_INVALID:
+		printf("eMMC installer: %s must be exactly %u bytes\n",
+		       BM201_INSTALLER_IDENTITY_FILE,
+		       BM201_INSTALLER_IDENTITY_BYTES);
+		break;
+	case BM201_INSTALLER_IDENTITY_READ_FAILED:
+		printf("eMMC installer: failed to read %s\n",
+		       BM201_INSTALLER_IDENTITY_FILE);
+		break;
+	case BM201_INSTALLER_IDENTITY_CHARACTER_INVALID:
+		printf("eMMC installer: %s is not lowercase hexadecimal\n",
+		       BM201_INSTALLER_IDENTITY_FILE);
+		break;
+	case BM201_INSTALLER_IDENTITY_NEWLINE_INVALID:
+		printf("eMMC installer: %s does not end with one newline\n",
+		       BM201_INSTALLER_IDENTITY_FILE);
+		break;
+	case BM201_INSTALLER_RECEIPT_SELECT_FAILED:
+		printf("eMMC installer: failed to select eMMC boot FAT %s %s\n",
+		       BM201_INSTALLER_BLOCK_INTERFACE,
+		       BM201_INSTALLER_EMMC_DEVICE);
+		break;
+	case BM201_INSTALLER_RECEIPT_STAT_FAILED:
+		printf("eMMC installer: failed to inspect %s\n",
+		       BM201_INSTALLER_RECEIPT_FILE);
+		break;
+	case BM201_INSTALLER_RECEIPT_READ_FAILED:
+		printf("eMMC installer: present %s could not be read\n",
+		       BM201_INSTALLER_RECEIPT_FILE);
+		break;
+	case BM201_INSTALLER_SOURCE_SD_SELECT_FAILED:
+		printf("eMMC installer: failed to reselect SD FAT %s %s\n",
+		       BM201_INSTALLER_BLOCK_INTERFACE,
+		       BM201_INSTALLER_SD_DEVICE);
 		break;
 	case BM201_INSTALLER_CONFIG_MISSING:
 		printf("eMMC installer: %s is missing\n", BM201_INSTALLER_CONFIG);
 		break;
+	case BM201_INSTALLER_CONFIG_STAT_FAILED:
+		printf("eMMC installer: failed to inspect %s\n",
+		       BM201_INSTALLER_CONFIG);
+		break;
 	case BM201_INSTALLER_CONFIG_EMPTY:
 		printf("eMMC installer: %s is empty\n", BM201_INSTALLER_CONFIG);
 		break;
 	case BM201_INSTALLER_PACKAGE_MISSING:
 		printf("eMMC installer: %s is missing\n", BM201_INSTALLER_PACKAGE);
 		break;
+	case BM201_INSTALLER_PACKAGE_STAT_FAILED:
+		printf("eMMC installer: failed to inspect %s\n",
+		       BM201_INSTALLER_PACKAGE);
+		break;
 	case BM201_INSTALLER_PACKAGE_EMPTY:
 		printf("eMMC installer: %s is empty\n", BM201_INSTALLER_PACKAGE);
 		break;
@@ -113,18 +211,26 @@ static int do_bm201_emmc_update(struct cmd_tbl *cmdtp, int flag, int argc,
 		       BM201_INSTALLER_PACKAGE,
 		       BM201_INSTALLER_MAX_PACKAGE_BYTES);
 		break;
-	case BM201_INSTALLER_MARKER_WRITE_FAILED:
-		printf("eMMC installer: failed to consume %s; eMMC was not written\n",
-		       BM201_INSTALLER_MARKER);
+	case BM201_INSTALLER_BURN_FAILED:
+		printf("eMMC installer: burn did not return zero; receipt not written\n");
+		break;
+	case BM201_INSTALLER_RECEIPT_FINAL_SELECT_FAILED:
+		printf("eMMC installer: burn succeeded but eMMC boot FAT reselection failed\n");
+		break;
+	case BM201_INSTALLER_RECEIPT_WRITE_FAILED:
+		printf("eMMC installer: burn succeeded but %s could not be written\n",
+		       BM201_INSTALLER_RECEIPT_FILE);
 		break;
-	case BM201_INSTALLER_MARKER_VERIFY_FAILED:
-		printf("eMMC installer: could not verify marker consumption; eMMC was not written\n");
+	case BM201_INSTALLER_RECEIPT_VERIFY_READ_FAILED:
+		printf("eMMC installer: failed to read back %s\n",
+		       BM201_INSTALLER_RECEIPT_FILE);
 		break;
-	case BM201_INSTALLER_MARKER_NOT_CONSUMED:
-		printf("eMMC installer: consumed marker content did not persist; eMMC was not written\n");
+	case BM201_INSTALLER_RECEIPT_VERIFY_MISMATCH:
+		printf("eMMC installer: %s readback did not match the package identity\n",
+		       BM201_INSTALLER_RECEIPT_FILE);
 		break;
-	case BM201_INSTALLER_BURN_RETURNED:
-		printf("eMMC installer: sdc_burn returned unexpectedly; refusing normal boot\n");
+	case BM201_INSTALLER_RESET_RETURNED:
+		printf("eMMC installer: reset returned unexpectedly; refusing normal boot\n");
 		break;
 	}
 
@@ -133,6 +239,6 @@ static int do_bm201_emmc_update(struct cmd_tbl *cmdtp, int flag, int argc,
 
 U_BOOT_CMD(
 	bm201_emmc_update, 1, 0, do_bm201_emmc_update,
-	"consume a one-shot SD request and install the eMMC system package",
+	"install a requested eMMC system package unless its receipt matches",
 	""
 );
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer_logic.h b/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer_logic.h
index aa06c3f..5beeee7 100644
--- a/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer_logic.h
+++ b/bl33/v2023/board/amlogic/s7d_bm201/emmc_installer_logic.h
@@ -4,76 +4,150 @@
 
 #include "bm201_emmc_installer.h"
 
+enum bm201_installer_file_status {
+	BM201_INSTALLER_FILE_OK = 0,
+	BM201_INSTALLER_FILE_MISSING,
+	BM201_INSTALLER_FILE_ERROR,
+};
+
 enum bm201_installer_result {
 	BM201_INSTALLER_NO_REQUEST = 0,
-	BM201_INSTALLER_MARKER_INVALID,
+	BM201_INSTALLER_ALREADY_INSTALLED,
+	BM201_INSTALLER_REQUEST_SD_SELECT_FAILED,
+	BM201_INSTALLER_REQUEST_STAT_FAILED,
+	BM201_INSTALLER_REQUEST_LENGTH_INVALID,
+	BM201_INSTALLER_REQUEST_READ_FAILED,
+	BM201_INSTALLER_REQUEST_CONTENT_INVALID,
+	BM201_INSTALLER_IDENTITY_MISSING,
+	BM201_INSTALLER_IDENTITY_STAT_FAILED,
+	BM201_INSTALLER_IDENTITY_LENGTH_INVALID,
+	BM201_INSTALLER_IDENTITY_READ_FAILED,
+	BM201_INSTALLER_IDENTITY_CHARACTER_INVALID,
+	BM201_INSTALLER_IDENTITY_NEWLINE_INVALID,
+	BM201_INSTALLER_RECEIPT_SELECT_FAILED,
+	BM201_INSTALLER_RECEIPT_STAT_FAILED,
+	BM201_INSTALLER_RECEIPT_READ_FAILED,
+	BM201_INSTALLER_SOURCE_SD_SELECT_FAILED,
 	BM201_INSTALLER_CONFIG_MISSING,
+	BM201_INSTALLER_CONFIG_STAT_FAILED,
 	BM201_INSTALLER_CONFIG_EMPTY,
 	BM201_INSTALLER_PACKAGE_MISSING,
+	BM201_INSTALLER_PACKAGE_STAT_FAILED,
 	BM201_INSTALLER_PACKAGE_EMPTY,
 	BM201_INSTALLER_PACKAGE_TOO_LARGE,
-	BM201_INSTALLER_MARKER_WRITE_FAILED,
-	BM201_INSTALLER_MARKER_VERIFY_FAILED,
-	BM201_INSTALLER_MARKER_NOT_CONSUMED,
-	BM201_INSTALLER_BURN_RETURNED,
+	BM201_INSTALLER_BURN_FAILED,
+	BM201_INSTALLER_RECEIPT_FINAL_SELECT_FAILED,
+	BM201_INSTALLER_RECEIPT_WRITE_FAILED,
+	BM201_INSTALLER_RECEIPT_VERIFY_READ_FAILED,
+	BM201_INSTALLER_RECEIPT_VERIFY_MISMATCH,
+	BM201_INSTALLER_RESET_RETURNED,
 };
 
 struct bm201_installer_ops {
-	int (*file_size)(void *context, const char *path,
-			 unsigned long long *size);
+	int (*select_sd)(void *context);
+	int (*select_emmc)(void *context);
+	enum bm201_installer_file_status (*file_size)(
+		void *context, const char *path, unsigned long long *size);
 	int (*read_file)(void *context, const char *path, void *buffer,
 			 unsigned int length);
 	int (*write_file)(void *context, const char *path, const void *buffer,
 			  unsigned int length);
 	int (*burn)(void *context);
+	void (*reset)(void *context);
 };
 
 static inline enum bm201_installer_result
 bm201_installer_run(const struct bm201_installer_ops *ops, void *context)
 {
+	enum bm201_installer_file_status status;
 	unsigned long long size;
-	char marker[sizeof(BM201_INSTALLER_CONSUMED)];
+	unsigned int index;
+	char request[sizeof(BM201_INSTALLER_REQUEST_CONTENT) - 1];
+	char identity[BM201_INSTALLER_IDENTITY_BYTES];
+	char receipt[BM201_INSTALLER_IDENTITY_BYTES];
 
-	if (ops->file_size(context, BM201_INSTALLER_MARKER, &size))
-		return BM201_INSTALLER_NO_REQUEST;
-	if (size != sizeof(BM201_INSTALLER_REQUEST) - 1 &&
-	    size != sizeof(BM201_INSTALLER_CONSUMED) - 1)
-		return BM201_INSTALLER_MARKER_INVALID;
-	if (ops->read_file(context, BM201_INSTALLER_MARKER, marker, size))
-		return BM201_INSTALLER_MARKER_INVALID;
-	if (size == sizeof(BM201_INSTALLER_CONSUMED) - 1 &&
-	    !memcmp(marker, BM201_INSTALLER_CONSUMED, size))
+	if (ops->select_sd(context))
+		return BM201_INSTALLER_REQUEST_SD_SELECT_FAILED;
+	status = ops->file_size(context, BM201_INSTALLER_REQUEST_FILE, &size);
+	if (status == BM201_INSTALLER_FILE_MISSING)
 		return BM201_INSTALLER_NO_REQUEST;
-	if (size != sizeof(BM201_INSTALLER_REQUEST) - 1 ||
-	    memcmp(marker, BM201_INSTALLER_REQUEST, size))
-		return BM201_INSTALLER_MARKER_INVALID;
+	if (status != BM201_INSTALLER_FILE_OK)
+		return BM201_INSTALLER_REQUEST_STAT_FAILED;
+	if (size != sizeof(BM201_INSTALLER_REQUEST_CONTENT) - 1)
+		return BM201_INSTALLER_REQUEST_LENGTH_INVALID;
+	if (ops->read_file(context, BM201_INSTALLER_REQUEST_FILE, request,
+			   sizeof(request)))
+		return BM201_INSTALLER_REQUEST_READ_FAILED;
+	if (memcmp(request, BM201_INSTALLER_REQUEST_CONTENT, sizeof(request)))
+		return BM201_INSTALLER_REQUEST_CONTENT_INVALID;
+
+	status = ops->file_size(context, BM201_INSTALLER_IDENTITY_FILE, &size);
+	if (status == BM201_INSTALLER_FILE_MISSING)
+		return BM201_INSTALLER_IDENTITY_MISSING;
+	if (status != BM201_INSTALLER_FILE_OK)
+		return BM201_INSTALLER_IDENTITY_STAT_FAILED;
+	if (size != BM201_INSTALLER_IDENTITY_BYTES)
+		return BM201_INSTALLER_IDENTITY_LENGTH_INVALID;
+	if (ops->read_file(context, BM201_INSTALLER_IDENTITY_FILE, identity,
+			   sizeof(identity)))
+		return BM201_INSTALLER_IDENTITY_READ_FAILED;
+	for (index = 0; index < BM201_INSTALLER_SHA256_HEX_BYTES; index++) {
+		if ((identity[index] < '0' || identity[index] > '9') &&
+		    (identity[index] < 'a' || identity[index] > 'f'))
+			return BM201_INSTALLER_IDENTITY_CHARACTER_INVALID;
+	}
+	if (identity[BM201_INSTALLER_SHA256_HEX_BYTES] != '\n')
+		return BM201_INSTALLER_IDENTITY_NEWLINE_INVALID;
+
+	if (ops->select_emmc(context))
+		return BM201_INSTALLER_RECEIPT_SELECT_FAILED;
+	status = ops->file_size(context, BM201_INSTALLER_RECEIPT_FILE, &size);
+	if (status == BM201_INSTALLER_FILE_ERROR)
+		return BM201_INSTALLER_RECEIPT_STAT_FAILED;
+	if (status == BM201_INSTALLER_FILE_OK &&
+	    size == BM201_INSTALLER_IDENTITY_BYTES) {
+		if (ops->read_file(context, BM201_INSTALLER_RECEIPT_FILE, receipt,
+				   sizeof(receipt)))
+			return BM201_INSTALLER_RECEIPT_READ_FAILED;
+		if (!memcmp(receipt, identity, sizeof(receipt)))
+			return BM201_INSTALLER_ALREADY_INSTALLED;
+	}
 
-	if (ops->file_size(context, BM201_INSTALLER_CONFIG, &size))
+	if (ops->select_sd(context))
+		return BM201_INSTALLER_SOURCE_SD_SELECT_FAILED;
+	status = ops->file_size(context, BM201_INSTALLER_CONFIG, &size);
+	if (status == BM201_INSTALLER_FILE_MISSING)
 		return BM201_INSTALLER_CONFIG_MISSING;
+	if (status != BM201_INSTALLER_FILE_OK)
+		return BM201_INSTALLER_CONFIG_STAT_FAILED;
 	if (!size)
 		return BM201_INSTALLER_CONFIG_EMPTY;
 
-	if (ops->file_size(context, BM201_INSTALLER_PACKAGE, &size))
+	status = ops->file_size(context, BM201_INSTALLER_PACKAGE, &size);
+	if (status == BM201_INSTALLER_FILE_MISSING)
 		return BM201_INSTALLER_PACKAGE_MISSING;
+	if (status != BM201_INSTALLER_FILE_OK)
+		return BM201_INSTALLER_PACKAGE_STAT_FAILED;
 	if (!size)
 		return BM201_INSTALLER_PACKAGE_EMPTY;
 	if (size > BM201_INSTALLER_MAX_PACKAGE_BYTES)
 		return BM201_INSTALLER_PACKAGE_TOO_LARGE;
 
-	if (ops->write_file(context, BM201_INSTALLER_MARKER,
-			    BM201_INSTALLER_CONSUMED,
-			    sizeof(BM201_INSTALLER_CONSUMED) - 1))
-		return BM201_INSTALLER_MARKER_WRITE_FAILED;
-	if (ops->read_file(context, BM201_INSTALLER_MARKER, marker,
-			   sizeof(BM201_INSTALLER_CONSUMED) - 1))
-		return BM201_INSTALLER_MARKER_VERIFY_FAILED;
-	if (memcmp(marker, BM201_INSTALLER_CONSUMED,
-		   sizeof(BM201_INSTALLER_CONSUMED) - 1))
-		return BM201_INSTALLER_MARKER_NOT_CONSUMED;
+	if (ops->burn(context))
+		return BM201_INSTALLER_BURN_FAILED;
+	if (ops->select_emmc(context))
+		return BM201_INSTALLER_RECEIPT_FINAL_SELECT_FAILED;
+	if (ops->write_file(context, BM201_INSTALLER_RECEIPT_FILE, identity,
+			    sizeof(identity)))
+		return BM201_INSTALLER_RECEIPT_WRITE_FAILED;
+	if (ops->read_file(context, BM201_INSTALLER_RECEIPT_FILE, receipt,
+			   sizeof(receipt)))
+		return BM201_INSTALLER_RECEIPT_VERIFY_READ_FAILED;
+	if (memcmp(receipt, identity, sizeof(receipt)))
+		return BM201_INSTALLER_RECEIPT_VERIFY_MISMATCH;
 
-	/* A successful burn reboots. Any return, including zero, is unsafe. */
-	ops->burn(context);
-	return BM201_INSTALLER_BURN_RETURNED;
+	ops->reset(context);
+	return BM201_INSTALLER_RESET_RETURNED;
 }
 
 #endif

