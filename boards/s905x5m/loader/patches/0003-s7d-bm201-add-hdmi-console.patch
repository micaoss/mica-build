From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Builder <builder@example.invalid>
Date: Wed, 26 Aug 2026 07:10:00 +0000
Subject: [PATCH] s7d: add a fail-safe HDMI and USB keyboard console

The S7D vendor display stack establishes HDMI and OSD scanout but does not
register a driver-model video device. Add a board-scoped video adapter that
publishes the existing RGB565 surface after vendor OSD initialization, allowing
the generic vidconsole to render text without owning display programming. The
adapter reads the framebuffer address selected by the runtime FDT directly from
the vendor GraphicDevice rather than duplicating it in U-Boot's embedded DT.
It also synchronizes OSD geometry to the mode VOUT actually selected, including
the safe 720p fallback used when the KVM's EDID cannot be parsed.

Initialize the vendor display path before probing that device, retain serial
in every console list, and expose the KVM's USB keyboard when it enumerates.
All optional failures leave serial usable and allow normal autoboot to
continue. The settings are runtime-only so a saved environment cannot remove
the recovery console and this code never persists a new environment.
---
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/Makefile b/bl33/v2023/board/amlogic/s7d_bm201/Makefile
--- a/bl33/v2023/board/amlogic/s7d_bm201/Makefile
+++ b/bl33/v2023/board/amlogic/s7d_bm201/Makefile
@@ -1 +1,2 @@
 obj-y += $(BOARD).o
+obj-$(CONFIG_VIDEO) += video.o
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/video.c b/bl33/v2023/board/amlogic/s7d_bm201/video.c
new file mode 100644
--- /dev/null
+++ b/bl33/v2023/board/amlogic/s7d_bm201/video.c
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Board-local video adapter for the vendor S7D OSD framebuffer. */
+
+#include <common.h>
+#include <dm.h>
+#include <env.h>
+#include <video.h>
+#include <amlogic/color.h>
+#include <amlogic/media/vout/aml_vout.h>
+#include <amlogic/video_fb.h>
+
+#define HDMI_CONSOLE_BYTES_PER_PIXEL 2
+
+extern GraphicDevice fb_gdev;
+
+static bool s7d_bm201_osd_geometry_supported(uint width, uint height)
+{
+	return (width == 1280 && height == 720) ||
+	       (width == 1920 && height == 1080);
+}
+
+int s7d_bm201_osd_video_prepare(void)
+{
+	struct vinfo_s *vinfo;
+	ulong width;
+	ulong height;
+	int ret;
+
+	/* Refresh geometry after vout has resolved any EDID fallback mode. */
+	vout_init();
+	vinfo = vout_get_current_vinfo();
+	if (!vinfo)
+		return -ENODEV;
+	width = vinfo->width;
+	height = vinfo->height;
+
+	if (!s7d_bm201_osd_geometry_supported(width, height)) {
+		printf("HDMI console: unsupported output geometry %lux%lu\n",
+		       width, height);
+		return -EINVAL;
+	}
+
+	ret = env_set_ulong("fb_width", width);
+	ret |= env_set_ulong("fb_height", height);
+	if (ret)
+		return ret;
+
+	printf("HDMI console: selected %lux%lu OSD geometry\n",
+	       width, height);
+	return 0;
+}
+
+static int s7d_bm201_osd_video_probe(struct udevice *dev)
+{
+	struct video_uc_plat *plat = dev_get_uclass_plat(dev);
+	struct video_priv *priv = dev_get_uclass_priv(dev);
+	ulong size;
+
+	if (!fb_gdev.frameAdrs ||
+	    !s7d_bm201_osd_geometry_supported(fb_gdev.fb_width,
+					       fb_gdev.fb_height) ||
+	    fb_gdev.gdfBytesPP != HDMI_CONSOLE_BYTES_PER_PIXEL ||
+	    fb_gdev.gdfIndex != COLOR_INDEX_16_565) {
+		printf("HDMI console: unsupported OSD framebuffer %x %ux%u@%u format %u\n",
+		       fb_gdev.frameAdrs, fb_gdev.fb_width, fb_gdev.fb_height,
+		       fb_gdev.gdfBytesPP * 8, fb_gdev.gdfIndex);
+		return -EINVAL;
+	}
+
+	size = fb_gdev.fb_width * fb_gdev.fb_height * fb_gdev.gdfBytesPP;
+	plat->base = fb_gdev.frameAdrs;
+	plat->size = size;
+	priv->xsize = fb_gdev.fb_width;
+	priv->ysize = fb_gdev.fb_height;
+	priv->bpix = VIDEO_BPP16;
+	video_set_flush_dcache(dev, true);
+
+	printf("HDMI console: using OSD framebuffer at 0x%x (%ux%u@16)\n",
+	       fb_gdev.frameAdrs, fb_gdev.fb_width, fb_gdev.fb_height);
+	return 0;
+}
+
+static const struct udevice_id s7d_bm201_osd_video_ids[] = {
+	{ .compatible = "amlogic,s7d-bm201-osd-video" },
+	{ }
+};
+
+U_BOOT_DRIVER(s7d_bm201_osd_video) = {
+	.name = "s7d_bm201_osd_video",
+	.id = UCLASS_VIDEO,
+	.of_match = s7d_bm201_osd_video_ids,
+	.probe = s7d_bm201_osd_video_probe,
+};
diff --git a/bl33/v2023/board/amlogic/s7d_bm201/s7d_bm201.c b/bl33/v2023/board/amlogic/s7d_bm201/s7d_bm201.c
index 79190ae0..d3587953 100644
--- a/bl33/v2023/board/amlogic/s7d_bm201/s7d_bm201.c
+++ b/bl33/v2023/board/amlogic/s7d_bm201/s7d_bm201.c
@@ -24,6 +24,7 @@
 #include <amlogic/board.h>
 #include <asm-generic/u-boot.h>
 #include <command.h>
+#include <stdio_dev.h>
 #include <asm/amlogic/arch/usb.h>
 #include <asm/amlogic/arch/stick_mem.h>
 
@@ -203,6 +204,10 @@ int board_init(void)
 
 int board_late_init(void)
 {
+	extern int s7d_bm201_osd_video_prepare(void);
+	struct udevice *video;
+	int ret;
+
 	printf("board late init\n");
 	env_set("defenv_para", "-c");
 	if (env_get_ulong("default_env", 10, 0))
@@ -226,6 +231,86 @@ int board_late_init(void)
 	PUSH_TIME_TE("vpu vpp init", BL33_VPUVPP_INIT_e);
 	set_usb_status();
 	aml_board_late_init_tail(NULL);
+
+	/* Keep serial usable unless every optional console component is ready. */
+	ret = env_set("stdin", "serial");
+	ret |= env_set("stdout", "serial");
+	ret |= env_set("stderr", "serial");
+	if (ret) {
+		printf("HDMI console: failed to establish serial recovery console\n");
+		return 0;
+	}
+
+	ret = env_set("bootdelay", "3");
+	if (ret) {
+		printf("HDMI console: failed to set autoboot delay (%d)\n", ret);
+		return 0;
+	}
+
+	ret = run_command("vout output ${outputmode}", 0);
+	if (ret) {
+		printf("HDMI console: failed to set output mode (%d)\n", ret);
+		return 0;
+	}
+
+	ret = s7d_bm201_osd_video_prepare();
+	if (ret) {
+		printf("HDMI console: failed to set OSD geometry (%d)\n", ret);
+		return 0;
+	}
+
+	ret = run_command("osd open", 0);
+	if (ret) {
+		printf("HDMI console: failed to open OSD (%d)\n", ret);
+		return 0;
+	}
+
+	ret = uclass_get_device(UCLASS_VIDEO, 0, &video);
+	if (ret) {
+		printf("HDMI console: video probe failed (%d)\n", ret);
+		return 0;
+	}
+
+	ret = run_command("osd enable", 0);
+	if (ret) {
+		printf("HDMI console: failed to enable OSD plane (%d)\n", ret);
+		return 0;
+	}
+
+	if (!stdio_get_by_name("vidconsole")) {
+		printf("HDMI console: vidconsole was not registered\n");
+		return 0;
+	}
+
+	if (env_set("stdout", "serial,vidconsole") ||
+	    env_set("stderr", "serial,vidconsole")) {
+		env_set("stdout", "serial");
+		env_set("stderr", "serial");
+		printf("HDMI console: failed to enable output multiplexing\n");
+		return 0;
+	}
+
+	printf("HDMI console: serial and video output enabled\n");
+
+	ret = run_command("usb start", 0);
+	if (ret) {
+		printf("HDMI console: USB start failed (%d); serial input retained\n",
+		       ret);
+		return 0;
+	}
+
+	if (!stdio_get_by_name("usbkbd")) {
+		printf("HDMI console: USB keyboard not found; serial input retained\n");
+		return 0;
+	}
+
+	if (env_set("stdin", "serial,usbkbd")) {
+		env_set("stdin", "serial");
+		printf("HDMI console: failed to enable input multiplexing\n");
+		return 0;
+	}
+
+	printf("HDMI console: serial and USB keyboard input enabled\n");
 	return 0;
 }
 
