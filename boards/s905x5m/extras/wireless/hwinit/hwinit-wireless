#!/bin/sh
# Power the Seekwave combo module, load its SDIO/Wi-Fi/vHCI stack in order,
# and wait for the runtime endpoints named in /etc/mica/wireless.conf.
set -eu

CONF=${MICA_CONF:-/etc/mica/wireless.conf}
[ -r "$CONF" ] || exit 0
conf_get() { sed -n "s/^$1=//p" "$CONF" | head -n1; }

power=$(conf_get power-control)
platform=$(conf_get platform-module)
modules=$(conf_get transport-modules)
wifi=0
bluetooth=0
[ ! -r "${CONF%/*}/wifi.conf" ] || wifi=1
[ ! -r "${CONF%/*}/bluetooth.conf" ] || bluetooth=1
[ "$wifi$bluetooth" != 00 ] || exit 0
interface=$(conf_get interface)
wifi_module=$(conf_get wifi-module)
bt_transport=$(conf_get bt-transport)
vhci=$(conf_get vhci)
limit=$(conf_get wait-seconds)
limit=${limit:-15}

[ -n "$power" ] && [ -n "$platform" ] && [ -n "$modules" ] || {
    echo "wireless: incomplete power/module facts in $CONF" >&2
    exit 1
}
modprobe -q "$platform"
[ -w "$power" ] || {
    echo "wireless: power control is missing or not writable: $power" >&2
    exit 1
}
printf '1\n' > "$power"
for module in $modules; do modprobe -q "$module"; done
[ "$wifi" = 0 ] || modprobe -q "$wifi_module"
[ "$bluetooth" = 0 ] || modprobe -q hci_vhci

ready() {
    if [ "$wifi" = 1 ]; then
        [ -n "$interface" ] && [ -e "/sys/class/net/$interface" ] || return 1
    fi
    if [ "$bluetooth" = 1 ]; then
        [ -c "$bt_transport" ] && [ -c "$vhci" ] || return 1
    fi
    return 0
}
waited=0
while ! ready && [ "$waited" -lt "$limit" ]; do
    sleep 1
    waited=$((waited + 1))
done
ready || {
    echo "wireless: selected radio endpoints were not ready within ${limit}s" >&2
    exit 1
}
