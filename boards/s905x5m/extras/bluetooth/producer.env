PACKAGES="mica-s905x5m-bluetooth"
ARCHES="arm64"
BUILD_CONTEXTS="board=boards/s905x5m common=common/package"
PREPARE="prepare.sh"
# What the hook builds from (`make -C boards/s905x5m userland`) is declared in
# mica-inputs beside this file, which the package inputs hash is taken over.
ENABLEMENT="mica-s905x5m-bluetooth=1"
