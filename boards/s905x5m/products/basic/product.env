# The s905x5m basic image, the board's default product: the eMMC full image without the container engine, on the
# production profile (development keys, development channel), released as its USB burning package alone.
PROFILE=prod
FEATURES="micad ui ssh tools mqtt wifi bluetooth"
COMPONENTS=""
STORAGE_LAYOUT=emmc
IMAGE_KINDS="usb-burn"
# The device code, from the CID of the board's eMMC (on an SD product too, since the eMMC stays on the board).
DEVICE_CODE_SOURCE=emmc-cid
