# The s905x5m SD full image, every feature on the production profile (development keys, development channel): micad,
# MQTT, containers and both radios. Its release carries the SD image and sd-boot, the loader eMMC boot0 needs first.
PROFILE=prod
# The trial confirm budget over the board's (boards/s905x5m/watchdog.env): PROVISIONAL, an SD card's writes vary
# tenfold between cards and the first boot grows DATA on it; until a bench measures a first boot and a trial boot.
WATCHDOG_CONFIRM_S=1200
FEATURES="micad ui ssh tools mqtt containers iproute2 wifi bluetooth"
COMPONENTS=""
IMAGE_KINDS="disk sd-boot"
# The device code, from the CID of the board's eMMC (on an SD product too, since the eMMC stays on the board).
DEVICE_CODE_SOURCE=emmc-cid
# Temporarily, claiming the device asks for no code: the console, the only place a default device shows its code,
# is reachable only over the serial wiring. Back to required once the code is reachable without it (label, BLE or
# another path).
CLAIM_DEVICE_CODE=off
