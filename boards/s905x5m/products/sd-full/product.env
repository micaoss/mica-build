# The s905x5m SD full image, every feature on the production profile (development keys, development channel): micad,
# MQTT, containers and both radios. Its release carries the SD image and sd-boot, the loader eMMC boot0 needs first.
PROFILE=prod
FEATURES="micad ui ssh tools mqtt containers iproute2 wifi bluetooth"
COMPONENTS=""
IMAGE_KINDS="disk sd-boot"
# The device code, from the CID of the board's eMMC (on an SD product too, since the eMMC stays on the board).
DEVICE_CODE_SOURCE=emmc-cid
