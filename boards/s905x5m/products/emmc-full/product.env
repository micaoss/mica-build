# The S905X5M eMMC full image: the SD full image's features and profile on the eMMC layout (vendor slots 4-6 kept),
# released as its USB burning package alone (the usb-burn image kind; the raw eMMC image is built, not published).
PROFILE=prod
FEATURES="micad ui ssh tools mqtt containers wifi bluetooth"
COMPONENTS=""
STORAGE_LAYOUT=emmc
IMAGE_KINDS="usb-burn"
