# The S905X5M eMMC full image: the SD full image's features and profile on the eMMC layout (the vendor reserved slot 4 kept),
# released as its USB burning package alone (the usb-burn image kind; the raw eMMC image is built, not published).
PROFILE=prod
FEATURES="micad ui ssh tools mqtt containers iproute2 wifi bluetooth"
COMPONENTS=""
STORAGE_LAYOUT=emmc
IMAGE_KINDS="usb-burn"
# The device code, from the CID of the board's eMMC (on an SD product too, since the eMMC stays on the board).
DEVICE_CODE_SOURCE=emmc-cid
# Claiming the device asks for the code its label carries.
CLAIM_DEVICE_CODE=required
