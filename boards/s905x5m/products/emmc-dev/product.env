# The S905X5M eMMC development image, flashed through its USB burning package (the usb-burn image kind).
PROFILE=dev
FEATURES="micad ui ssh tools mqtt containers wifi bluetooth"
COMPONENTS=""
STORAGE_LAYOUT=emmc
IMAGE_KINDS="disk usb-burn"
# The device code, from the CID of the board's eMMC (on an SD product too, since the eMMC stays on the board).
DEVICE_CODE_SOURCE=emmc-cid
