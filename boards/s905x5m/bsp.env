# What this board's kernel and U-Boot builds take: the file names under
# kernel/. Plain KEY=value, included by the board's Makefile and handed to the
# Dockerfiles as build arguments; the upstream source pins are in ../../locks/upstream.lock.
# The kernel release the pinned tree must report.
KERNEL_EXPECT=6.12.38-m100-arm64
KERNEL_CONFIG=kernel-s905x5m.config
# The board's config fragments in merge order; @mica-required is the shared
# floor's place in it (common/kernel/mica-required.fragment).
KERNEL_FRAGMENTS=runtime.fragment wireless.fragment @mica-required signed-boot.fragment
KERNEL_DTB=s7d_s905x5m_m100.dtb
KERNEL_DTB_ARTIFACT=s7d_s905x5m_m100.dtb
