# The Google Compute Engine image: uefi-x64.docker's features without MQTT on the production profile (the shared
# uefi-x64 kernel, development keys, development channel), with Compute Engine's defaults. Docker is the container
# engine (mica-docker, as uefi-x64.docker), so no podman and no MQTT bridge or broker. OpenSSH is on from the first
# boot, keys only; the people who log in are the users of the instance's ssh-keys metadata (mica-gce-agent).
# Imported from its gce image kind (disk.raw in an oldgnu tar.gz, a whole GiB); DATA grows to the disk at boot.
PROFILE=prod
FEATURES="micad ui ssh tools containers iproute2"
CONTAINER_ENGINE=docker
SSH_SERVER=openssh
SSH=on
# The agent and sudo (manifests/component-gce.pkgs); the agent's unit is enabled here. The metadata users are
# administrators (sudo) while micad's access.cloudAdmins is unset; the console's switch revokes it.
COMPONENTS="gce"
ENABLE_UNITS="mica-gce-agent.service"
CLOUD_ADMINS=on
# An instance has no serial a label carries: micad draws the code once and keeps it on DATA; the owner reads it
# after an SSH login, and claiming asks for it.
DEVICE_CODE_SOURCE=random
CLAIM_DEVICE_CODE=required
# A cloud network has no neighbours to announce the device to.
MDNS=off
SSDP=off
# Compute Engine has no i6300ESB: the runkit arms the kernel's softdog.
WATCHDOG="Software Watchdog"
IMAGE_KINDS="disk gce"
