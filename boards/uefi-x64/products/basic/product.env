# The generic UEFI x64 basic image, the board's default product, on the production profile (development keys,
# development channel): the management daemon and API, SSH, the operator tools and MQTT; no container engine.
PROFILE=prod
FEATURES="micad ui ssh tools mqtt"
COMPONENTS=""
# The device code, from the firmware's serial number; dmi-uuid where the units carry an OEM placeholder serial.
DEVICE_CODE_SOURCE=dmi-serial
