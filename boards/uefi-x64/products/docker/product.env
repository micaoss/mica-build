# The generic UEFI x64 full image with Docker as its container engine: every feature of uefi-x64.full on the
# production profile, with mica-docker in place of mica-podman. micad enables docker.service from
# container.enabled; containers are made on the device with docker and docker compose.
PROFILE=prod
FEATURES="micad ui ssh tools mqtt containers iproute2"
CONTAINER_ENGINE=docker
COMPONENTS=""
