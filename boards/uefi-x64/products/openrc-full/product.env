# The generic UEFI x64 full image on OpenRC: every feature of uefi-x64.full (the management daemon and API, MQTT,
# the container engine supervised by mica-containerd) on the production profile, with OpenRC as the init.
PROFILE=prod
INIT=openrc
FEATURES="micad ui ssh tools mqtt containers"
COMPONENTS=""
# The device code, from the firmware's serial number; dmi-uuid where the units carry an OEM placeholder serial.
DEVICE_CODE_SOURCE=dmi-serial
