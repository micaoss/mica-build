# uefi-x64.gcp with its DATA encrypted (field-20261109 W1): LUKS2 on DATA, unlocked at boot by the instance's vTPM
# (a Shielded VM instance with --shielded-vtpm), and refused rather than left plain when no TPM answers.
# Test channel only: RELEASE=never keeps it out of every release workflow. It builds only against a mica-core pin
# that reads dataEncryption (src/product/data-encryption.ts).
PROFILE=prod
FEATURES="micad ui ssh tools containers iproute2"
CONTAINER_ENGINE=docker
SSH_SERVER=openssh
SSH=on
COMPONENTS="gce"
ENABLE_UNITS="mica-gce-agent.service"
CLOUD_ADMINS=on
DEVICE_CODE_SOURCE=random
CLAIM_DEVICE_CODE=required
MDNS=off
SSDP=off
WATCHDOG="Software Watchdog"
IMAGE_KINDS="disk gce"
DATA_ENCRYPTION=on
DATA_KEY_PROVIDERS="tpm2"
DATA_ENCRYPTION_NO_PROVIDER=refuse
RELEASE=never
