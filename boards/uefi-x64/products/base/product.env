# The generic UEFI x64 base image: the base alone, without the management daemon, its API or the console. SSH is
# on from the first boot and takes its keys from a provisioning medium's mica-authorized-keys; the operator
# tools, MQTT and the container engine are switched on by hand with mica-units. Updates install daily under the
# auto policy and run from the next boot.
PROFILE=prod
FEATURES="ssh tools mqtt containers iproute2"
SSH=on
COMPONENTS=""
# The device code, from the firmware's serial number, for the label.
DEVICE_CODE_SOURCE=dmi-serial
