# The generic UEFI/ACPI arm64 full image, every feature on the production profile (development keys, development channel): micad, MQTT and containers.
PROFILE=prod
FEATURES="micad ui ssh tools mqtt containers iproute2"
COMPONENTS=""
# The device code, from the firmware's serial number; dmi-uuid where the units carry an OEM placeholder serial.
DEVICE_CODE_SOURCE=dmi-serial
