# The generic UEFI/ACPI arm64 development image: micad, MQTT and containers.
PROFILE=dev
FEATURES="micad ui ssh tools mqtt containers"
COMPONENTS=""
# The device code, from the firmware's serial number; dmi-uuid where the units carry an OEM placeholder serial.
DEVICE_CODE_SOURCE=dmi-serial
# Claiming the device asks for no code: its serial is a placeholder no label carries.
CLAIM_DEVICE_CODE=off
