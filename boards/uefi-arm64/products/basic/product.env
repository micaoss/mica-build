# The generic UEFI/ACPI arm64 basic image, the board's default product, on the production profile (development
# keys, development channel): the management daemon and API, SSH, the operator tools and MQTT; no container engine.
PROFILE=prod
FEATURES="micad ui ssh tools mqtt"
COMPONENTS=""
# The device code, from the firmware's serial number; dmi-uuid where the units carry an OEM placeholder serial.
DEVICE_CODE_SOURCE=dmi-serial
# Claiming the device asks for no code: its serial is a placeholder no label carries.
CLAIM_DEVICE_CODE=off
