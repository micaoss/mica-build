# uefi-arm64 kernel configuration -- the board's own requirements, merged over
# arm64's `defconfig` after common/kernel/mica-required.fragment.
#
# THIS FILE IS THE INTENT AND THE ASSERTION LIST. Every `=y` line here is
# asserted against the resolved `.config` after `olddefconfig`, so a symbol
# whose dependencies stopped being met fails the build instead of vanishing.
# config/uefi-arm64.config beside it is the RESOLVED result, recorded so that a
# kernel bump shows up as a reviewable diff rather than as a build input nobody
# saw.
#
# Every `# CONFIG_X is not set` line is asserted the same way since 2026-09-20,
# as "no line turns it on": such a line is a REQUEST kconfig is free to refuse,
# and nineteen of the ones that used to be here had been refused. What they had
# in common is worth keeping and asserts nothing -- DRM_PANEL, DRM_BRIDGE,
# EXTCON, NVMEM, RESET_CONTROLLER and the MDIO/PHY libraries are `select`ed by
# the drivers that use them, so turning one off means turning off what selects
# it, which is what the display trim below does.
#
# `=y` and not `=m` throughout, and that is the point of the board: it boots
# root=/dev/dm-0 from a `dm-mod.create=` table with NO INITRAMFS, so nothing can
# load a module before the root filesystem exists. Everything the kernel needs
# in order to find, verify and mount the root is therefore built in.
#
# WHAT IS NOT HERE. The verity floor, the container-network floor and the
# security/LSM baseline are board-independent and live in
# common/kernel/mica-required.fragment, which the build merges FIRST and asserts
# by the same loop. A line restated here would be a second statement free to
# disagree with the first.
#
# HOW THIS DIFFERS FROM boards/uefi-x64/kernel/config/uefi-x64.fragment. The two
# boards run the same software on the same boot contract and are the same kind
# of board: the generic UEFI/ACPI machine of their architecture (user, 2026-09-16
# -- the generic systems are uefi-x64 and uefi-arm64; cx3576 and s905x5m are the
# hardware boards). Only the architecture and its machine differ: an arm64 SBBR
# machine presents its devices over PCIe with a PL011 console, where the x86 one
# has its legacy console and an EFI framebuffer. QEMU's aarch64 `virt` is one
# such machine -- the one the acceptance suites drive -- and not the definition
# of the board.

# --- how the root device is found -------------------------------------------
# EVERY STORAGE FAMILY A GENERIC UEFI MACHINE BOOTS FROM IS BUILT IN, because
# the root is found before any module can be loaded: virtio for a VM, NVMe and
# AHCI/SATA over PCIe, and USB mass storage behind xHCI/EHCI. SD/eMMC is not
# here: an SBBR machine's firmware boots the ESP, and a platform MMC controller
# is hardware-specific -- a board that boots from one is a hardware board of its
# own (cx3576, s905x5m), not this generic image.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_MMIO=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCIEPORTBUS=y
CONFIG_BLK_DEV=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_VIRTIO=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=y
# A console keyboard on a machine with no serial line in reach.
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_EVDEV=y

# --- how the partitions are read --------------------------------------------
# GPT exposes the fixed SYSTEM/DATA/ESP identities used by authenticated early init.
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# --- the filesystems the layout mounts --------------------------------------
# ext4 backs SYSTEM and DATA; vfat backs the ESP and its native boot records.
# Built-in NLS support is required to mount the ESP before selecting entries.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_UTF8=y

# --- the network a generic machine has --------------------------------------
# virtio-net is built in: it is the acceptance transport and costs nothing.
# The physical NICs are MODULES, and deliberately: networking is not needed to
# find or verify the root, so they load from the support image like any other
# driver, and the set can grow without touching the boot path. The families are
# the ones a UEFI/ACPI arm64 server or SBC actually presents over PCIe.
CONFIG_VIRTIO_NET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_PHYLIB=m
CONFIG_FIXED_PHY=m
CONFIG_REALTEK_PHY=m
CONFIG_MARVELL_PHY=m
CONFIG_MICREL_PHY=m
CONFIG_BROADCOM_PHY=m
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=m
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX5_CORE=m
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=m

# --- the console board.env names --------------------------
# BOARD_CMDLINE_ARGS is `console=ttyAMA0,115200`, one entry and no tty0,
# because the aarch64 `virt` machine has no VGA and no framebuffer. ttyAMA0 is
# the PL011, which is the machine's only console, so both the driver and its
# console hook have to be built in or the argument names a console that is not
# there and a headless boot is indistinguishable from a hang.
#
# NOTE: cx3576 gives no precedent for this. Its config carries
# `# CONFIG_SERIAL_AMBA_PL011 is not set` -- a Rockchip board consoles through
# a vendor 8250 variant at ttyFIQ0 -- so the PL011 is new to this tree.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y

# --- firmware and boot ------------------------------------------------------
# Firmware authenticates systemd-boot and the signed UKI. EFI_STUB launches the
# embedded kernel/initramfs; efivarfs exposes the native boot handoff variables.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
# ACPI and SMBIOS are what an SBBR machine describes itself with, and the EFI
# clock is the one every such machine has when its SoC RTC is not driven.
CONFIG_ACPI=y
CONFIG_DMI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_EFI=y
CONFIG_RTC_DRV_PL031=y

# --- what systemd needs to be pid 1 -----------------------------------------
# Not speculative: each of these is a hard requirement in systemd's own README,
# and the failure mode for most of them is a boot that reaches pid 1 and stops
# there rather than a message naming the symbol.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_AUTOFS_FS=y
CONFIG_BLK_DEV_LOOP=y
# systemd-repart grows DATA on first boot by rewriting the GPT and asking the
# kernel to re-read it; without the partition rescan path that is a write
# nothing acts on until the next reboot.
CONFIG_BLOCK_LEGACY_AUTOLOAD=y

# --- parents the shared floor needs -----------------------------------------
# Everything in this block is here for one reason: the shared floor names a
# symbol that arm64's `defconfig` leaves nothing to select. None of it is a
# product requirement -- each is what THIS BOARD'S STARTING POINT happens to
# leave off -- which is why it lives here and not in common/kernel/, where it
# would be imposed on every future board as a defconfig quirk. uefi-x64's fragment
# carries its own version of this block for the identical reason.
#
# CONFIG_NETFILTER_ADVANCED gates a whole submenu and the floor's
# CONFIG_BRIDGE_NETFILTER sits inside it (`depends on NETFILTER_ADVANCED`).
# With the parent off, olddefconfig does not report the child as `is not set` --
# it drops the symbol entirely, which is how a required option goes missing
# with no line to point at.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# CONFIG_TRACING, which the floor requires so that fs/tracefs is built -- it
# says at its own line that tracefs has no Kconfig symbol of its own and that
# the entry is an assertion. TRACING is not user-settable: it is `select`ed by
# GENERIC_TRACER, which the event sources below select in turn.
#
# MEASURED, not assumed. arm64 `defconfig` resolves to
# `# CONFIG_FTRACE is not set` -- the entire menu is off, so nothing selects
# TRACING and the floor's line went missing with no `is not set` to point at,
# exactly the failure mode the netfilter note above describes. x86_64_defconfig
# turns FTRACE on together with the kprobe, uprobe and blktrace event sources,
# which is why uefi-x64 holds the floor without naming any of this.
#
# The two named here are the smallest set that reproduces uefi-x64's outcome:
# FTRACE opens the menu, and BLK_DEV_IO_TRACE selects GENERIC_TRACER, which
# selects TRACING. The kprobe/uprobe event sources uefi-x64 also happens to get are
# NOT added -- they are not needed for tracefs and this board has no reason to
# carry them just because the other board's defconfig does.
CONFIG_FTRACE=y
CONFIG_BLK_DEV_IO_TRACE=y

# --- crypto the boot path uses ----------------------------------------------
# dm-verity's hash algorithm is sha256 (rootfs/build.sh writes it into the
# table as HASH_ALGO), and it is asked for through the crypto API before any
# module could be loaded.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_LIB_SHA256=y

# --- the board half of the disk-encryption capability ------------------------
# common/kernel/mica-required.fragment carries the generic xts(aes) the crypt
# target resolves through, and says at length that it is a capability with no
# consumer in the image. This is the ARMv8 Crypto Extensions AES that the same
# resolution prefers when it is present, and it is the exact counterpart of
# uefi-x64's CONFIG_CRYPTO_AES_NI_INTEL -- neither exists on the other architecture,
# which is why neither can live in the shared floor. cx3576 carries this same
# symbol.
#
# NOT `CONFIG_ARM64_CRYPTO`: that umbrella symbol is gone from this kernel
# generation -- it appears nowhere in cx3576's resolved 6.12 config -- so
# naming it here would fail this file's own `=y` assertion on a line that is
# simply obsolete.
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y

# --- what uefi-arm64 deliberately does NOT have ------------------------------
# The machine is QEMU `virt` as mica-build runs it (mica-build's evaluation,
# 2026-09-15): -cpu max, virtio-blk-pci, virtio-net-pci, an i6300esb watchdog,
# virtio-9p-pci for the lifecycle import, a PL011 console, AAVMF. Everything
# below is hardware that machine never presents, switched off at its menu so
# arm64 `defconfig`'s board support does not ride along: no module of it is
# built, packed or shipped. What the guest needs is asserted =y above and
# listed in config/uefi-arm64.required (tools/kernel-config-test.sh).

# physical platforms and their SoC support
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
