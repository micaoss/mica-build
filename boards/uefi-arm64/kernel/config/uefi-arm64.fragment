# CONFIG_GPIO_ALTERA is not set

# the PHY, MDIO and platform leaves arm64 `defconfig` names one by one
# CONFIG_AQUANTIA_PHY is not set
# CONFIG_BCM54140_PHY is not set
# CONFIG_MARVELL_10G_PHY is not set
# CONFIG_MARVELL_88Q2XXX_PHY is not set
# CONFIG_MICROSEMI_PHY is not set
# CONFIG_ROCKCHIP_PHY is not set
# CONFIG_DP83867_PHY is not set
# CONFIG_DP83869_PHY is not set
# CONFIG_DP83TD510_PHY is not set
# CONFIG_VITESSE_PHY is not set
# CONFIG_MDIO_BITBANG is not set
# CONFIG_MDIO_GPIO is not set
# MDIO_BCM_UNIMAC IS SELECTED AND THE REQUEST TO DROP IT WAS ONLY PARTLY
# GRANTED: a modular selector leaves kconfig free to answer m, and it did.
# Written here as the value it actually resolves to rather than as a
# `# ... is not set` line that the resolved config contradicts -- measured
# 2026-09-20 by deleting the line and re-recording, which turned it into a
# built-in. The nineteen other off-lines removed in the same round had no
# effect on the resolution at all; this one did.
CONFIG_MDIO_BCM_UNIMAC=m
# CONFIG_MDIO_BUS_MUX_MULTIPLEXER is not set
# CONFIG_MDIO_BUS_MUX_MMIOREG is not set
# CONFIG_PCI_MESON is not set
# CONFIG_PCI_ENDPOINT_TEST is not set
# CONFIG_POWER_SEQUENCING is not set
# CONFIG_RTC_DRV_MT6397 is not set
# CONFIG_RPMSG_CHAR is not set
# CONFIG_RPMSG_CTRL is not set
# CONFIG_PHY_CAN_TRANSCEIVER is not set
# CONFIG_PHY_CADENCE_TORRENT is not set
# CONFIG_PHY_CADENCE_DPHY_RX is not set
# CONFIG_PHY_CADENCE_SALVO is not set
# CONFIG_NVMEM_LAYOUT_SL28_VPD is not set
# CONFIG_NVMEM_RMEM is not set
# CONFIG_NVMEM_REBOOT_MODE is not set
# CONFIG_MUX_GPIO is not set
# CONFIG_MUX_MMIO is not set
# CONFIG_GPIO_AGGREGATOR is not set
# CONFIG_PSTORE_RAM is not set
# CONFIG_CRYPTO_TEST is not set

# crypto accelerators
# CONFIG_CRYPTO_HW is not set

# The acceptance VM exposes the same PCI watchdog as uefi-x64.
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_I6300ESB_WDT=y

# THE BOOT LOGO, 2026-09-20 (user decision: the behaviour is uniform across the
# boards that can draw). CONFIG_LOGO with the CLUT224 variant compiles the PPM
# the kernel prepare step renders from common/kernel/splash.png; the position
# comes from fbcon=logo-pos: in BOARD_CMDLINE_ARGS, and the logind drop-in and
# the getty@tty1 mask in package/overlay keep the VT it lands on idle. All five
# move together behind BOARD_BOOT_LOGO, which board-contract-test asserts.
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
# Only the CLUT224 logo: `defconfig` turns the mono and VGA16 variants on
# beside it, and they are dead payload on a board with a colour framebuffer.
# cx3576's configure hook disables the same two.
# CONFIG_LOGO_LINUX_MONO is not set
# CONFIG_LOGO_LINUX_VGA16 is not set

# THE pstore BACKEND OF A UEFI MACHINE: EFI variables. The shared floor sets
# CONFIG_PSTORE and leaves the medium to the board, because a generic UEFI
# machine has no reserved RAM region to put a ramoops in -- its memory map is
# the firmware's. Measured bounds, since a diagnostic that fills somebody's
# NVRAM is worse than none: efi-pstore writes one variable per record of
# record_size bytes, 1024 by default (drivers/firmware/efi/efi-pstore.c:13),
# and the kernel refuses a write that the firmware's own
# QueryVariableInfo says will not fit (check_var_size, drivers/firmware/efi/
# vars.c:26, falling back to a 64 KiB ceiling where the firmware does not
# implement it). What bounds ACCUMULATION is systemd-pstore, which copies the
# records out and unlinks them; without that unit the variables stay.
CONFIG_EFI_VARS_PSTORE=y
# CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE is not set
