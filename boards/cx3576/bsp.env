# What this board's kernel and U-Boot builds take: the file names under
# kernel/ and the SoC's U-Boot inputs. Plain KEY=value, included by the
# board's Makefile and handed to the Dockerfiles as build arguments; the
# upstream source pins are in ../../locks/upstream.lock.
# The kernel release the pinned tree must report.
KERNEL_EXPECT=6.1.115
KERNEL_CONFIG=kernel-cx3576z.config
KERNEL_DTB=rk3576-cx3576z.dtb
# The name the assembly reads the device tree under, out of the bundle.
KERNEL_DTB_ARTIFACT=rk3576-src.dtb
UBOOT_DEFCONFIG=generic-rk3576_defconfig
DDR_BLOB=rk3576_ddr_lp4_2112MHz_lp5_2736MHz_v1.12.bin
BL31_BLOB=rk3576_bl31_v1.24.elf
