#!/sbin/openrc-run

description="Attach the AIC8800D80 Bluetooth HCI on UART4"
command="/usr/bin/btattach"
command_args="-B /dev/ttyS4 -P h4 -S 1500000"
command_background=true
pidfile="/run/aic-bluetooth.pid"
output_log="/var/log/aic-bluetooth.log"
error_log="/var/log/aic-bluetooth.log"

depend() {
	need dbus rk-board
	before bluetooth
}

start_pre() {
	if [ ! -c /dev/ttyS4 ]; then
		eerror "Bluetooth UART /dev/ttyS4 is missing"
		return 1
	fi

	modprobe aic8800_btlpm || return 1
	rfkill unblock bluetooth || return 1
}

start_post() {
	local count=0
	while [ "$count" -lt 50 ]; do
		[ -e /sys/class/bluetooth/hci0 ] && return 0
		sleep 0.1
		count=$((count + 1))
	done
	ewarn "hci0 did not appear within 5 seconds; inspect /var/log/aic-bluetooth.log"
}
