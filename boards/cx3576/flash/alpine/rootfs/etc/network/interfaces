# /etc/network/interfaces -- managed by ifupdown-ng/OpenRC networking
auto lo
iface lo inet loopback

# Onboard GMAC0 + YT8531
auto eth0
iface eth0 inet dhcp

# Second Ethernet port: PCIe RTL8168
auto eth1
iface eth1 inet dhcp

# Wi-Fi starts by default and stays idle without a network={} block.
# Add credentials and reload wpa_supplicant or reboot to connect.
auto wlan0
iface wlan0 inet dhcp

# The routed SoC controller is CAN1, but Linux names the only registered CAN
# netdev can0. Use classic CAN at 250 kbit/s; CAN FD is intentionally disabled.
auto can0
iface can0 inet manual
	pre-up /sbin/ip link set dev "$IFACE" type can bitrate 250000 fd off
	up /sbin/ip link set dev "$IFACE" up
	down /sbin/ip link set dev "$IFACE" down

# Static address example. Replace the DHCP stanza, then run:
# ifdown eth0; ifup eth0
# auto eth0
# iface eth0 inet static
#	address 192.168.1.100/24
#	gateway 192.168.1.1

source /etc/network/interfaces.d/*
