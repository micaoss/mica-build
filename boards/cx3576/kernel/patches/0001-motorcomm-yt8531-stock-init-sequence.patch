 {
 	int ret = 0, val;
 
+	if (yt8531_stock_init)
+		return yt8531_config_init_stock(phydev);
+
 #if (YTPHY8531A_XTAL_INIT)
 	ret = yt8531a_xtal_init(phydev);
 	if (ret < 0)
