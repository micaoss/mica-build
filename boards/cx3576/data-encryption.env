# DATA encryption (src/product/data-encryption.ts, mica-core W1): the cipher (the SoC has the ARMv8 AES
# instructions) and the recovery key's KDF memory a product of this board that encrypts DATA gets; no key
# provider yet. Kept out of board.env on purpose: board.env is an input of the board package and component, and
# these facts only matter to a product with DATA_ENCRYPTION=on.
DATA_CIPHER=aes-xts-plain64
DATA_RECOVERY_MEMORY_KIB=65536
