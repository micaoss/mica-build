From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CX3576-Z BSP <bsp@cx3576z.local>
Date: Thu, 20 Aug 2026 12:00:00 +0200
Subject: [PATCH] rk3576: generic: CX3576-Z USB host, boot LED and rescue boot
 order

Describe the CX3576-Z hardware that the rescue paths depend on:

- Enable the second DWC3 controller as a USB2 host together with the
  board's host-port power enables (GPIO2_A6/GPIO2_A7, active-high hogs)
  so a USB stick works as a boot and rescue medium in U-Boot proper.
- Describe the vcc5v0_3v3 rail enable (GPIO4_B2, active-high) that
  feeds the peripheral supplies instead of relying on its power-on
  default state.
- Add the work LED (GPIO0_B4) plus the red/blue status pair
  (GPIO4_C7 active-low/GPIO4_B0 active-high), so preboot can explicitly show the booting state
  even without a serial console.
- Order bootstd devices eMMC, SD, USB: eMMC boots first and an
  inserted rescue SD card is only reached when eMMC offers no bootable
  flow, so a rescue card cannot override a working eMMC system.

Upstream-Status: Inappropriate [board integration]
---
diff --git a/arch/arm/dts/rk3576-generic.dts b/arch/arm/dts/rk3576-generic.dts
index 88f8cb6..1be17f4 100644
--- a/arch/arm/dts/rk3576-generic.dts
+++ b/arch/arm/dts/rk3576-generic.dts
@@ -90,3 +90,85 @@
 	phy-names = "usb2-phy";
 	status = "okay";
 };
+
+/ {
+	bootstd {
+		compatible = "u-boot,boot-std";
+		/* Rescue policy: eMMC first, SD as fallback, then USB. */
+		bootdev-order = "mmc0", "mmc1", "usb";
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_work: led-work {
+			label = "work";
+			gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_HIGH>;
+		};
+
+		led_status_red: led-status-red {
+			label = "status-red";
+			gpios = <&gpio4 RK_PC7 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		led_status_blue: led-status-blue {
+			label = "status-blue";
+			gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+
+	vcc5v0_3v3: vcc5v0-3v3-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio4 RK_PB2 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc5v0_3v3_pwren>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+&gpio2 {
+	usb-host1-pwren-hog {
+		gpio-hog;
+		gpios = <RK_PA6 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "usb-host1-pwren";
+	};
+
+	usb-host3-pwren-hog {
+		gpio-hog;
+		gpios = <RK_PA7 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "usb-host3-pwren";
+	};
+};
+
+&pinctrl {
+	vcc5v0-3v3-en {
+		vcc5v0_3v3_pwren: vcc5v0-3v3-pwren {
+			rockchip,pins = <4 RK_PB2 0 &pcfg_pull_none>;
+		};
+	};
+};
+
+&u2phy1 {
+	status = "okay";
+};
+
+&u2phy1_otg {
+	status = "okay";
+};
+
+&usb_drd1_dwc3 {
+	dr_mode = "host";
+	maximum-speed = "high-speed";
+	phys = <&u2phy1_otg>;
+	phy-names = "usb2-phy";
+	status = "okay";
+};
diff --git a/configs/generic-rk3576_defconfig b/configs/generic-rk3576_defconfig
index b35e214..0413d84 100644
--- a/configs/generic-rk3576_defconfig
+++ b/configs/generic-rk3576_defconfig
@@ -25,8 +25,10 @@ CONFIG_CMD_MEMINFO_MAP=y
 CONFIG_CMD_GPIO=y
 CONFIG_CMD_GPT=y
 CONFIG_CMD_MISC=y
+CONFIG_CMD_LED=y
 CONFIG_CMD_MMC=y
 CONFIG_CMD_ROCKUSB=y
+CONFIG_CMD_USB=y
 CONFIG_CMD_USB_MASS_STORAGE=y
 # CONFIG_CMD_SETEXPR is not set
 CONFIG_CMD_RNG=y
@@ -36,7 +38,10 @@ CONFIG_OF_SPL_REMOVE_PROPS="clock-names interrupt-parent assigned-clocks assigne
 CONFIG_NO_NET=y
 # CONFIG_ADC is not set
 # CONFIG_USB_FUNCTION_FASTBOOT is not set
+CONFIG_GPIO_HOG=y
 CONFIG_ROCKCHIP_GPIO=y
+CONFIG_LED=y
+CONFIG_LED_GPIO=y
 CONFIG_SUPPORT_EMMC_RPMB=y
 CONFIG_MMC_DW=y
 CONFIG_MMC_DW_ROCKCHIP=y
@@ -49,8 +54,10 @@ CONFIG_DEBUG_UART_SHIFT=2
 CONFIG_SYS_NS16550_MEM32=y
 CONFIG_SYSRESET_PSCI=y
 CONFIG_USB=y
+CONFIG_USB_XHCI_HCD=y
 CONFIG_USB_DWC3=y
 CONFIG_USB_DWC3_GENERIC=y
+CONFIG_USB_STORAGE=y
 CONFIG_USB_GADGET=y
 CONFIG_USB_GADGET_DOWNLOAD=y
 CONFIG_USB_FUNCTION_ROCKUSB=y
-- 
