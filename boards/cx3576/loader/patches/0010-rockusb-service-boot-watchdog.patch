Subject: [PATCH] rockusb: service the boot watchdog while waiting for USB

Signed boot arms a watchdog before entering recovery. The RockUSB idle
loop must run cyclic service even when Ctrl-C and USB traffic are absent.
Upstream-Status: Pending

diff --git a/cmd/rockusb.c b/cmd/rockusb.c
--- a/cmd/rockusb.c
+++ b/cmd/rockusb.c
@@ -7,4 +7,5 @@
 #include <console.h>
 #include <g_dnl.h>
+#include <u-boot/schedule.h>
 #include <usb.h>
 #include <asm/arch-rockchip/f_rockusb.h>
@@ -54,11 +55,12 @@
-	while (1) {
-		if (g_dnl_detach())
-			break;
-		if (ctrlc())
-			break;
-		dm_usb_gadget_handle_interrupts(udc);
-		rockusb_flush_write_cache_if_idle();
-	}
-	ret = CMD_RET_SUCCESS;
-
+	while (1) {
+		if (g_dnl_detach())
+			break;
+		if (ctrlc())
+			break;
+		schedule();
+		dm_usb_gadget_handle_interrupts(udc);
+		rockusb_flush_write_cache_if_idle();
+	}
+	ret = CMD_RET_SUCCESS;
+
 exit:
