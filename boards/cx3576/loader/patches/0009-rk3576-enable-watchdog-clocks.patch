Subject: [PATCH] clk: rockchip: rk3576: enable watchdog clocks

The DesignWare watchdog probe calls clk_enable before accessing registers.
Without an enable callback the RK3576 provider returns ENOSYS, so the required
boot watchdog never probes. Open WDT0 pclk and tclk gates explicitly. Preserve
the existing unsupported result for clock IDs without a gate implementation.

WDT0 uses CRU_CLKGATE_CON16 bits 7 (pclk) and 8 (24 MHz tclk), as declared in
Rockchip's RK3576 Linux clock driver.
Upstream-Status: Pending

--- a/drivers/clk/rockchip/clk_rk3576.c
+++ b/drivers/clk/rockchip/clk_rk3576.c
@@ -2411,4 +2411,22 @@
+static int rk3576_clk_enable(struct clk *clk)
+{
+	struct rk3576_clk_priv *priv = dev_get_priv(clk->dev);
+
+	switch (clk->id) {
+	case PCLK_WDT0:
+		rk_clrreg(&priv->cru->clkgate_con[16], BIT(7));
+		return 0;
+	case TCLK_WDT0:
+		/* DesignWare requests tclk; register access also needs pclk. */
+		rk_clrreg(&priv->cru->clkgate_con[16], BIT(7) | BIT(8));
+		return 0;
+	default:
+		return -ENOSYS;
+	}
+}
+
 static struct clk_ops rk3576_clk_ops = {
-	.get_rate = rk3576_clk_get_rate,
-	.set_rate = rk3576_clk_set_rate,
+	.enable = rk3576_clk_enable,
+	.get_rate = rk3576_clk_get_rate,
+	.set_rate = rk3576_clk_set_rate,
 #if (IS_ENABLED(OF_CONTROL)) || (!IS_ENABLED(OF_PLATDATA))
