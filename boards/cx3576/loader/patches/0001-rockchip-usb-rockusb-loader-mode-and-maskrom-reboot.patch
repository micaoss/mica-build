rockchip: usb: report rockusb as loader; honor K_FW_RESET reboot subcodes

Rockchip host tools (rkdeveloptool / upgrade_tool / RKDevTool) classify a
device purely by bcdUSB & 1: 0x0200 = maskrom (BootROM), 0x0201 = loader.
Mainline g_dnl keeps the default 0x0200, so rockusb shows up as Maskrom and
tools enable maskrom-only paths (0x471/0x472 control transfers) that this
gadget cannot serve. Vendor U-Boot sets 0x0201 in its g_dnl_bind_fixup.

The composite setup path rewrites bcdUSB while serving every device
descriptor, after g_dnl_bind_fixup has run. Preserve the low discriminator
bit while selecting the USB 2.0 or USB 3.1 version so the board fixup reaches
the host.

Also implement the rkusb_set_reboot_flag() weak hook: tools send K_FW_RESET
with subcode 0x03 (reboot to BootROM download / maskrom) or 0x06 (reboot to
loader). Writing the matching flag to the boot mode register lets
'upgrade_tool uf' and 'rkdeveloptool rd 3' bounce the board from our rockusb
into real maskrom, mirroring stock loader behavior. Handle BOOT_LOADER on the
next boot by replacing preboot with a one-shot rockusb command; mainline's
setup_boot_mode() otherwise clears that flag and continues a normal boot.

Upstream-Status: Pending (against v2026.07)
---
--- a/arch/arm/mach-rockchip/board.c
+++ b/arch/arm/mach-rockchip/board.c
@@ -226,8 +226,35 @@
 	else
 		put_unaligned(CONFIG_USB_GADGET_PRODUCT_NUM, &dev->idProduct);
 
+	/*
+	 * Rockchip host tools read bcdUSB & 1 as loader-vs-maskrom. Without
+	 * the odd value they treat rockusb as a BootROM device and speak the
+	 * 0x471/0x472 maskrom protocol this gadget does not implement.
+	 */
+	if (!strcmp(name, "usb_dnl_rockusb"))
+		put_unaligned(cpu_to_le16(0x0201), &dev->bcdUSB);
+
 	return 0;
 }
+
+#if IS_ENABLED(CONFIG_USB_FUNCTION_ROCKUSB)
+void rkusb_set_reboot_flag(int flag);
+void rkusb_set_reboot_flag(int flag)
+{
+	/*
+	 * K_FW_RESET subcodes sent by Rockchip host tools ("uf" bounces a
+	 * loader-mode device back to real maskrom this way):
+	 * 0x03 = reboot to BootROM download, 0x06 = reboot to loader.
+	 */
+	if (!CONFIG_ROCKCHIP_BOOT_MODE_REG)
+		return;
+
+	if (flag == 0x03)
+		writel(BOOT_BROM_DOWNLOAD, CONFIG_ROCKCHIP_BOOT_MODE_REG);
+	else if (flag == 0x06)
+		writel(BOOT_LOADER, CONFIG_ROCKCHIP_BOOT_MODE_REG);
+}
+#endif /* CONFIG_USB_FUNCTION_ROCKUSB */
 #endif /* CONFIG_USB_GADGET_DOWNLOAD */
 
 #if IS_ENABLED(CONFIG_USB_GADGET_DWC2_OTG) && !IS_ENABLED(CONFIG_DM_USB_GADGET)
diff --git a/arch/arm/mach-rockchip/boot_mode.c b/arch/arm/mach-rockchip/boot_mode.c
--- a/arch/arm/mach-rockchip/boot_mode.c
+++ b/arch/arm/mach-rockchip/boot_mode.c
@@ -99,6 +99,10 @@ int setup_boot_mode(void)
 	writel(BOOT_NORMAL, reg);
 
 	switch (boot_mode) {
+	case BOOT_LOADER:
+		debug("%s: enter rockusb loader!\n", __func__);
+		env_set("preboot", "setenv preboot; rockusb 0 mmc 0");
+		break;
 	case BOOT_FASTBOOT:
 		debug("%s: enter fastboot!\n", __func__);
 		env_set("preboot", "setenv preboot; fastboot usb 0");
diff --git a/drivers/usb/gadget/composite.c b/drivers/usb/gadget/composite.c
--- a/drivers/usb/gadget/composite.c
+++ b/drivers/usb/gadget/composite.c
@@ -1048,10 +1048,13 @@ composite_setup(struct usb_gadget *gadget, const struct usb_ctrlrequest *ctrl)
 			cdev->desc.bMaxPacketSize0 =
 				cdev->gadget->ep0->maxpacket;
 			if (gadget->speed >= USB_SPEED_SUPER) {
-				cdev->desc.bcdUSB = cpu_to_le16(0x0310);
+				cdev->desc.bcdUSB = cpu_to_le16(0x0310 |
+					(le16_to_cpu(cdev->desc.bcdUSB) & 0x0001));
 				cdev->desc.bMaxPacketSize0 = 9;
 			} else {
-				cdev->desc.bcdUSB = cpu_to_le16(0x0200);
+				/* Preserve a protocol discriminator set by board fixup. */
+				cdev->desc.bcdUSB = cpu_to_le16(0x0200 |
+					(le16_to_cpu(cdev->desc.bcdUSB) & 0x0001));
 			}
 			value = min(w_length, (u16) sizeof cdev->desc);
 			memcpy(req->buf, &cdev->desc, value);
