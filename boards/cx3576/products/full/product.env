# The cx3576 full image, every feature on the production profile (development keys, development channel): micad,
# MQTT, containers and both radios. Docker is its container engine (mica-docker in place of mica-podman: micad
# enables docker.service from container.enabled; containers are made on the device with docker and docker compose),
# and OpenSSH its SSH server (mica-openssh in place of mica-ssh).
PROFILE=prod
FEATURES="micad ui ssh tools mqtt containers iproute2 wifi bluetooth"
CONTAINER_ENGINE=docker
SSH_SERVER=openssh
COMPONENTS=""
# The device code, from the CID of the board's eMMC (on an SD product too, since the eMMC stays on the board).
DEVICE_CODE_SOURCE=emmc-cid
# Temporarily, claiming the device asks for no code: the console, the only place a default device shows its code,
# is reachable only over the serial wiring. Back to required once the code is reachable without it (label, BLE or
# another path).
CLAIM_DEVICE_CODE=off
