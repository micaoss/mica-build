# The cx3576 development image: micad, MQTT, containers and both radios.
PROFILE=dev
FEATURES="micad ui ssh tools mqtt containers wifi bluetooth"
COMPONENTS=""
# The device code, from the CID of the board's eMMC (on an SD product too, since the eMMC stays on the board).
DEVICE_CODE_SOURCE=emmc-cid
# Temporarily, claiming the device asks for no code: the console, the only place a default device shows its code,
# is reachable only over the serial wiring. Back to required once the code is reachable without it (label, BLE or
# another path).
CLAIM_DEVICE_CODE=off
