# mini-x64 kernel configuration -- the board's own requirements, merged over `tinyconfig`
# after common/kernel/mica-required.fragment.
#
# THIS FILE IS THE INTENT AND THE ASSERTION LIST. Every `=y` line here is asserted against
# the resolved `.config` after `olddefconfig`, so a symbol whose dependencies stopped being
# met fails the build instead of vanishing. config/mini-x64.config beside it is the RESOLVED
# result, recorded so that a kernel bump shows up as a reviewable diff.
#
# THE BASE IS tinyconfig, not x86_64_defconfig: the mini boards exist to run from 128 MB of
# flash (mica:docs/plan/20260926-0930-mini-images-on-128-mb.md), and the defconfig base is
# most of the 15.1 MB the generic uefi-x64 kernel weighs. Everything below is what a Mica root
# needs on top of nothing: the platform, the root's storage and verification, what systemd
# asks of a kernel, a serial console and a network. No display, no USB, no sound: the mini
# boards are headless, and a driver added later is one line here.
#
# `=y` and not `=m` throughout: the root is dm-verity with no module loading before it is up.
# The verity floor, the container floor and the security baseline are
# common/kernel/mica-required.fragment's, merged first and asserted by the same loop.

# --- the platform -------------------------------------------------------------
# tinyconfig on an x86 host is 32-bit; the image is x86_64.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_POSIX_TIMERS=y
CONFIG_EVENTFD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_ACPI=y
CONFIG_DMI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
# The kernel image is xz: the boot artifact is read once, at boot, and every byte of it is
# stored twice (the running and the next deployment's UKI).
CONFIG_KERNEL_XZ=y
# The UKI's initrd is zstd (the runkit's /init, rdinit= on the command line).
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# Module support with no module: the build indexes modules.builtin and modules.dep for the
# support image and for udev's modprobe, and an index needs the machinery on.
CONFIG_MODULES=y

# --- EFI ----------------------------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_VARS_PSTORE=y
# CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE is not set

# --- what the floor's symbols stand on ---------------------------------------
# tinyconfig leaves the menus the floor's symbols live in closed, so they are opened here:
# device-mapper sits under MD, squashfs and pstore under MISC_FILESYSTEMS, the IPC namespace
# needs System V IPC, and tracefs (the floor's CONFIG_TRACING) comes with the default tracers,
# the cheapest thing that selects it -- no function tracer is compiled in.
CONFIG_MD=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y

# --- the root's storage -------------------------------------------------------
# virtio for the QEMU harness, NVMe, AHCI and SD/eMMC for the small flash parts this board is
# for (a 128 MB part is most often eMMC or a SATA disk-on-module).
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y

# --- filesystems --------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_QUOTACTL=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# The mini roots are xz squashfs (per-product compression); zstd stays for the generic ones.
CONFIG_SQUASHFS_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_AUTOFS_FS=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
# The QEMU suites share a directory with the guest over 9P.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# --- what systemd asks of the kernel ------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_BLK_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_UNIX98_PTYS=y

# --- the verity signature chain -----------------------------------------------
CONFIG_KEYS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
# The verity signing certificate is RSA.
CONFIG_CRYPTO_RSA=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_SYSTEM_DATA_VERIFICATION=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_LIB_SHA256=y

# --- the console --------------------------------------------------------------
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# --- the network --------------------------------------------------------------
# virtio and e1000 for QEMU, e1000e and r8169 for the small x86 boxes a 128 MB image runs on.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_TUN=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO_NET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
# CONFIG_NETFILTER_ADVANCED gates a whole submenu, and the floor's CONFIG_BRIDGE_NETFILTER
# sits inside it: `depends on NETFILTER_ADVANCED`.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# --- the watchdog -------------------------------------------------------------
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_I6300ESB_WDT=y
