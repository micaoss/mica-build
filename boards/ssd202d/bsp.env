# What this board's kernel and U-Boot builds take: the kernel's base configuration and the release the pinned
# tree must report. Plain KEY=value, included by the board's Makefile and handed to the Dockerfiles as
# build arguments; the upstream source pins are in ../../locks/upstream.lock.
KERNEL_EXPECT=6.12.114
KERNEL_DEFCONFIG=tinyconfig
# The configuration the gate holds the build to, recorded by `make kernel-config` (kernel/config/).
KERNEL_CONFIG=ssd202d.config
