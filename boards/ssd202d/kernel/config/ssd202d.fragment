# ssd202d: a SigmaStar SSD202D (2x Cortex-A7), the board's own options merged over `tinyconfig` after the
# composed floor (common/kernel/fragments/). Every =y line here is asserted against the resolved .config
# (kernel/configure.sh); config/ssd202d.config beside it is the resolved result.
#
# The base is tinyconfig, not multi_v7_defconfig: both deployments, the core set and the reserves share one
# 123.5 MiB UBI region, the defconfig base is a 12 MB zImage and 24 MB of modules for every Armv7 SoC, and the
# board has 128 MiB of RAM. What follows is what a Mica root needs on this SoC on top of nothing. Everything the
# boot reaches is built in: nothing is loaded before the root. The SoC drivers mainline lacks are the tree's carried commits.

# --- the platform -------------------------------------------------------------
# Armv7 multiplatform with the MStar/SigmaStar Armv7 SoCs, EABI with hardware floating point (Debian armhf;
# busybox faults without VFP). The second core is started through the SoC's smpctrl, not PSCI.
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MSTARV7=y
CONFIG_MACH_INFINITY=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_SMP=y
CONFIG_KERNEL_XZ=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_POSIX_TIMERS=y
# The 32-bit time system calls: tinyconfig drops them, and armhf userland built with a 32-bit time_t still makes
# them (mica-runkit's sleep among them).
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_EVENTFD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECURITY=y

# --- the SoC: clocks, interrupts, pins, GPIOs and DDR ------------------------------------
CONFIG_COMMON_CLK=y
CONFIG_MSTAR_MSC313_CPUPLL=y
CONFIG_MSTAR_MSC313_MPLL=y
CONFIG_MSTAR_MSC313_UPLL=y
CONFIG_MSTAR_MSC313_LPLL=y
CONFIG_MSTAR_MSC313_MIUPLL=y
CONFIG_MSTAR_MSC313_PM_MUXES=y
CONFIG_MSTAR_MSC313_CLKGEN=y
CONFIG_MSTAR_MSC313_SC_GP_CTRL_MUXES=y
CONFIG_SSD20XD_GPI=y
CONFIG_MSC313_PM_INTC=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MSC313=y
CONFIG_PINCTRL_MSC313_PM=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_MSC313=y
CONFIG_GPIO_MSC313_PM=y
CONFIG_MFD_SYSCON=y
CONFIG_MEMORY=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# --- the console, the clock and the forced command line ---------------------------
# pm_uart (ttyS0) is the console; the fuart (ttyS1) carries the radio module.
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MSC313=y
CONFIG_CMDLINE_FORCE=y

# --- the flash ------------------------------------------------------------------
# The SPI NAND behind the ISP controller; the device tree partitions it as flash.tsv does and the forced command
# line attaches the UBI partition (ubi.mtd=).
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_SPI_MSC313_ISP=y
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_SPI_NAND=y

# --- the root and the filesystems the image mounts ---------------------------------
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_MD=y
CONFIG_MISC_FILESYSTEMS=y
# The root is xz squashfs with the 32-bit Arm branch filters (board.env ROOTFS_COMPRESSION, -Xbcj arm,armthumb).
CONFIG_SQUASHFS_XZ=y
CONFIG_XZ_DEC_ARM=y
CONFIG_XZ_DEC_ARMTHUMB=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_FILE_LOCKING=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y

# --- what the root's services ask of the kernel -----------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- the verity signature ----------------------------------------------------------
CONFIG_KEYS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_CRYPTO_RSA=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_SYSTEM_DATA_VERIFICATION=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y

# --- the network ---------------------------------------------------------------------
# The EMAC (a Cadence MACB) and its integrated PHY. The firewall feature's nftables sits on netfilter.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_CADENCE=y
CONFIG_MACB=y
CONFIG_PHYLIB=y
CONFIG_MSC313_PHY=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# --- the watchdog ---------------------------------------------------------------------
# The SoC's watchdog, which also restarts the board (a carried commit: the PM sleep reset does not).
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_MSC313E_WATCHDOG=y

# --- the key and the LEDs ---------------------------------------------------------------
# The user key is a SAR GPIO, polled; the two LEDs are SoC GPIOs.
CONFIG_IIO=y
CONFIG_MSC313E_SAR=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
