# ssd202d: QEMU's virt machine with a Cortex-A15, the board's own options merged over `tinyconfig` after the
# composed floor (common/kernel/fragments/). Every =y line here is asserted against the resolved .config
# (kernel/configure.sh); config/ssd202d.config beside it is the resolved result.
#
# The base is tinyconfig, not multi_v7_defconfig: both deployments, the core set and the reserves share one
# 64 MiB UBI region, and the defconfig base is a 12 MB zImage and 24 MB of modules for every Armv7 SoC. What
# follows is what a Mica root needs on this machine on top of nothing. Everything the boot reaches is built in:
# nothing is loaded before the root.

# --- the platform -------------------------------------------------------------
# Armv7 multiplatform with the virt machine, EABI with hardware floating point (Debian armhf).
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_VIRT=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_SMP=y
CONFIG_ARM_PSCI=y
CONFIG_KERNEL_XZ=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_POSIX_TIMERS=y
# The 32-bit time system calls: tinyconfig drops them, and armhf userland built with a 32-bit time_t still makes
# them (mica-runkit's sleep among them).
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_EVENTFD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECURITY=y

# --- the console, the clock and the forced command line ---------------------------
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_CMDLINE_FORCE=y

# --- the flash ------------------------------------------------------------------
# Both pflash banks are one cfi-flash node, which physmap concatenates into one MTD; the forced command line
# partitions it (mtdparts=) and attaches the UBI partition (ubi.mtd=).
CONFIG_MTD_CFI=y
CONFIG_MTD_CFI_INTELEXT=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y

# --- the root and the filesystems the image mounts ---------------------------------
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_MD=y
CONFIG_MISC_FILESYSTEMS=y
# The root is xz squashfs with the 32-bit Arm branch filters (board.env ROOTFS_COMPRESSION, -Xbcj arm,armthumb).
CONFIG_SQUASHFS_XZ=y
CONFIG_XZ_DEC_ARM=y
CONFIG_XZ_DEC_ARMTHUMB=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_FILE_LOCKING=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y

# --- what the root's services ask of the kernel -----------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- the verity signature ----------------------------------------------------------
CONFIG_KEYS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_CRYPTO_RSA=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_SYSTEM_DATA_VERIFICATION=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y

# --- the network ---------------------------------------------------------------------
# virtio-net on the machine's virtio-mmio transports. The firewall feature's nftables sits on netfilter.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# --- the watchdog ---------------------------------------------------------------------
# An i6300ESB on QEMU's PCIe host (-device i6300esb). U-Boot drives none on this machine, so the kernel arms
# this one.
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_I6300ESB_WDT=y
