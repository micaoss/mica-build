From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mica build <mica@example.invalid>
Date: Thu, 22 Oct 2026 00:00:00 +0000
Subject: [PATCH] gpio: msc313: SSD20xD lines and the PM GPIO controller

gpio-msc313 learns the SSD20xD line set and takes its interrupts through the GPI; gpio-msc313-pm drives
the PM domain GPIOs.

Origin: https://github.com/linux-chenxing/linux.git mstar_v6_5_rebase 5de660288cdf709dd40882bc57170f81ab744dea
  drivers/gpio/gpio-msc313.c
  drivers/gpio/gpio-msc313-pm.c
Authors named by the carried files: Copyright (C) 2020 Daniel Palmer<daniel@thingy.jp>; Copyright (C) 2019 Daniel Palmer
License: GPL-2.0
---
 drivers/gpio/Kconfig          |   8 +
 drivers/gpio/Makefile         |   1 +
 drivers/gpio/gpio-msc313-pm.c | 392 ++++++++++++++++++++++++++++++++++
 drivers/gpio/gpio-msc313.c    | 166 ++++++++++++--
 4 files changed, 553 insertions(+), 14 deletions(-)
 create mode 100644 drivers/gpio/gpio-msc313-pm.c

diff --git a/drivers/gpio/Kconfig b/drivers/gpio/Kconfig
index d93cd4f72..8278cc3da 100644
--- a/drivers/gpio/Kconfig
+++ b/drivers/gpio/Kconfig
@@ -871,6 +871,14 @@ config GPIO_MSC313
 	  Say Y here to support the main GPIO block on MStar/SigmaStar
 	  ARMv7-based SoCs.
 
+config GPIO_MSC313_PM
+	bool "MStar MSC313 PM GPIO support"
+	default y if ARCH_MSTARV7
+	depends on ARCH_MSTARV7
+	select GPIOLIB_IRQCHIP
+	help
+	  Say Y here to support PM GPIO on MStar MSC313 and later SoCs.
+
 config GPIO_IDT3243X
 	tristate "IDT 79RC3243X GPIO support"
 	depends on MIKROTIK_RB532 || COMPILE_TEST
