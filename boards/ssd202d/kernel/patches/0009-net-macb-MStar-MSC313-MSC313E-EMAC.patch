+#endif
+
+	if (macb_config->rm9200_txq_len) {
+		bp->rm9200_txq_len = macb_config->rm9200_txq_len;
+		bp->rm9200_txq = devm_kcalloc(&pdev->dev,
+				macb_config->rm9200_txq_len,
