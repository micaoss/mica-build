+		MACB_CAPS_MSTAR_RIU | MACB_CAPS_MSTAR_TXQ,
+	.clk_init = msc313_clk_init,
+	.init = msc313_init,
+	.usrio = &macb_default_usrio,
+	.rm9200_txq_len = 4,
+};
