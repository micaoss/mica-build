+struct msc313_clkgen_gate {
+	struct regmap_field *force_on;
+	struct regmap_field *enrd;
+	struct clk_hw clk_hw;
+	struct clk_hw **clk_hw_dividers;
+};
+#define to_gate(_hw) container_of(_hw, struct msc313_clkgen_gate, clk_hw)
