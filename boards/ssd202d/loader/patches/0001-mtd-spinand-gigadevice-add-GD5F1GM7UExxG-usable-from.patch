From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mica build <mica@example.invalid>
Date: Thu, 22 Oct 2026 00:00:00 +0000
Subject: [PATCH] mtd: spinand: gigadevice: add GD5F1GM7UExxG, usable from the
 SPL

The SSD202D gateway carries a GigaDevice GD5F1GM7UExxG (ID c8 91, 2048 byte
pages, 64 pages per 128 KiB block, 1024 blocks, on-die ECC). Add it to the
GigaDevice table and let the SPL build the GigaDevice driver
(SPL_SPI_NAND_SUPPORT_GIGADEVICE), so the SPL can read U-Boot proper from it.

Origin: the board's bench patch against this tree (u-boot-fifteenhex-6e1a42f6-
ssd202d-ybo.patch), without its defconfig changes.
License: GPL-2.0+ (the files patched).

Upstream-Status: Inappropriate [board integration]
---
 common/spl/Kconfig                | 6 ++++++
 drivers/mtd/nand/spi/Makefile     | 1 +
 drivers/mtd/nand/spi/core.c       | 4 +++-
 drivers/mtd/nand/spi/gigadevice.c | 9 +++++++++
 4 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/common/spl/Kconfig b/common/spl/Kconfig
index 9f717479..21b94528 100644
--- a/common/spl/Kconfig
+++ b/common/spl/Kconfig
@@ -799,6 +799,12 @@ config SPL_SPI_NAND_SUPPORT_WINBOND
 	help
 	  Support Winbond SPI NAND in SPL
 
+config SPL_SPI_NAND_SUPPORT_GIGADEVICE
+	bool "Support GigaDevice SPI NAND"
+	depends on SPL_SPI_NAND_SUPPORT
+	help
+	  Support GigaDevice SPI NAND in SPL
+
 endif
 
 config SPL_UBI
diff --git a/drivers/mtd/nand/spi/Makefile b/drivers/mtd/nand/spi/Makefile
index fa98a0e2..fd08eeb1 100644
--- a/drivers/mtd/nand/spi/Makefile
+++ b/drivers/mtd/nand/spi/Makefile
@@ -5,6 +5,7 @@ spinand-objs := core.o
 spinand-objs += spl.o
 obj-$(CONFIG_SPL_SPI_NAND_SUPPORT_LONGSYS) += longsys.o
 obj-$(CONFIG_SPL_SPI_NAND_SUPPORT_WINBOND) += winbond.o
+obj-$(CONFIG_SPL_SPI_NAND_SUPPORT_GIGADEVICE) += gigadevice.o
 else
 spinand-objs := core.o gigadevice.o longsys.o macronix.o micron.o toshiba.o winbond.o xincun.o
 endif
diff --git a/drivers/mtd/nand/spi/core.c b/drivers/mtd/nand/spi/core.c
index 4c80e58a..22dab46f 100644
--- a/drivers/mtd/nand/spi/core.c
+++ b/drivers/mtd/nand/spi/core.c
@@ -866,7 +866,9 @@ static const struct nand_ops spinand_ops = {
 
 #ifdef CONFIG_SPL_BUILD
 static const struct spinand_manufacturer *spinand_manufacturers[] = {
-	//&gigadevice_spinand_manufacturer,
+#ifdef CONFIG_SPL_SPI_NAND_SUPPORT_GIGADEVICE
+	&gigadevice_spinand_manufacturer,
+#endif
 #ifdef CONFIG_SPL_SPI_NAND_SUPPORT_LONGSYS
 	&longsys_spinand_manufacturer,
 #endif
diff --git a/drivers/mtd/nand/spi/gigadevice.c b/drivers/mtd/nand/spi/gigadevice.c
index 17ed3bf7..bec7eef7 100644
--- a/drivers/mtd/nand/spi/gigadevice.c
+++ b/drivers/mtd/nand/spi/gigadevice.c
@@ -178,6 +178,15 @@ static const struct spinand_info gigadevice_spinand_table[] = {
 		     0,
 		     SPINAND_ECCINFO(&gd5fxgqxxexxg_ooblayout,
 				     gd5fxgq5xexxg_ecc_get_status)),
+	SPINAND_INFO("GD5F1GM7UExxG", 0x91,
+		     NAND_MEMORG(1, 2048, 128, 64, 1024, 1, 1, 1),
+		     NAND_ECCREQ(8, 512),
+		     SPINAND_INFO_OP_VARIANTS(&gd5f1gq5_read_cache_variants,
+					      &write_cache_variants,
+					      &update_cache_variants),
+		     SPINAND_HAS_QE_BIT,
+		     SPINAND_ECCINFO(&gd5fxgqxxexxg_ooblayout,
+				     gd5fxgq4xexxg_ecc_get_status)),
 };
 
 static int gigadevice_spinand_detect(struct spinand_device *spinand)
