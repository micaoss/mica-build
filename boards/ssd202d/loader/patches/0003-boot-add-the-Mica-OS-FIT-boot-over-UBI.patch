From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mica build <mica@example.invalid>
Date: Thu, 22 Oct 2026 00:00:00 +0000
Subject: [PATCH] boot: add the Mica OS FIT boot over UBI

The micaboot command selects the deployment from the boot record copies in
UBI volumes and boots its FIT from a static volume through standard U-Boot
autoboot. It transports only the deployment id after FIT verification.

Upstream-Status: Inappropriate [board integration]
---
 boot/Kconfig         | 22 ++++++++++++++++++++++
 common/Makefile      |  4 ++++
 common/fdt_support.c | 12 ++++++++++++
 3 files changed, 38 insertions(+)

diff --git a/boot/Kconfig b/boot/Kconfig
index 08451c65..6c9173bb 100644
--- a/boot/Kconfig
+++ b/boot/Kconfig
@@ -1339,3 +1339,25 @@ config SAVE_PREV_BL_INITRAMFS_START_ADDR
 	  will be created.
 
 endmenu		# Booting
+
+config MICA_UBI_BOOT
+	bool "Mica OS FIT boot over UBI"
+	depends on MTD_UBI && FIT
+	help
+	  Select the deployment from the boot record copies in the UBI volumes
+	  records-a and records-b, persist its trial counter with an atomic LEB
+	  change before anything is launched, and boot the FIT read whole from
+	  the static volume k-<kernelId>. Persistent storage carries data,
+	  never commands.
+
+config MICA_UBI_MTD
+	string "MTD partition holding the UBI device"
+	depends on MICA_UBI_BOOT
+
+config MICA_UBI_FIT_ADDRESS
+	hex "Address the FIT is read to"
+	depends on MICA_UBI_BOOT
+
+config MICA_UBI_FIT_LIMIT
+	int "Most bytes of a FIT read"
+	depends on MICA_UBI_BOOT
diff --git a/common/Makefile b/common/Makefile
index 75c24e32..b72ecdc5 100644
--- a/common/Makefile
+++ b/common/Makefile
@@ -117,3 +117,7 @@ obj-$(CONFIG_$(SPL_TPL_)STACKPROTECTOR) += stackprot.o
 obj-$(CONFIG_SCP03) += scp03.o
 
 obj-$(CONFIG_QFW) += qfw.o
+
+ifndef CONFIG_SPL_BUILD
+obj-$(CONFIG_MICA_UBI_BOOT) += mica-ubi-boot.o
+endif
diff --git a/common/fdt_support.c b/common/fdt_support.c
index 644cdd95..a3a6a8bb 100644
--- a/common/fdt_support.c
+++ b/common/fdt_support.c
@@ -293,6 +293,18 @@ int fdt_chosen(void *fdt)
 	if (nodeoffset < 0)
 		return nodeoffset;
 
+#if defined(CONFIG_MICA_UBI_BOOT) && !defined(CONFIG_SPL_BUILD)
+	{
+		extern char mica_deployment_id[65];
+
+		if (strlen(mica_deployment_id) != 64)
+			return -EINVAL;
+		err = fdt_setprop_string(fdt, nodeoffset, "mica,deployment-id", mica_deployment_id);
+		if (err)
+			return err;
+	}
+#endif
+
 	str = board_fdt_chosen_bootargs();
 
 	if (str) {
