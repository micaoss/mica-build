# The ssd202d image, on UBI in SPI NAND, on the production profile and OpenRC: the minimal image, the management
# daemon and API and SSH, busybox as the command set; no container engine. The board's only product.
PROFILE=prod
INIT=openrc
FEATURES="micad ssh"
COMPONENTS=""
# The device code, from the Ethernet port's permanent address (none is provisioned on this board yet).
DEVICE_CODE_SOURCE=mac
# Claiming the device asks for no code: the bench board has no provisioned code, and a wired-only first run
# claims over the console.
CLAIM_DEVICE_CODE=off
