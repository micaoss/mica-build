# Files that name a board on purpose, one repository-relative path per line,
# the reason after `#`. Everything else in the lint's scope dispatches on facts.
tests/signed-boot-lab/cx3576-control-fdt.sh        # a lab of one board's U-Boot control FDT
tests/signed-boot-lab/cx3576-control-fdt-inner.sh  # the same lab, inside the sandbox
tests/signed-boot-lab/fit-sandbox.sh               # slices the one FIT board's real kernel and DTB
tests/signed-boot-lab/fit-sandbox-inner.sh         # the same lab, inside the sandbox
tests/signed-boot-lab/verity-matrix.sh             # names the three boards' kernels in its hint
tests/signed-boot-lab/uefi-uki.sh                  # spells the EFI architecture as UEFI does (x64), which is also a board's name
tests/lifecycle-uboot-fit/firmware-io.sh           # compiles both FIT boards' loader sources, one flag each
tests/lifecycle-uboot-fit/image.py                 # inspects the rockchip medium by name
tests/lifecycle-uefi/native-input.test.ts          # a fixture enumerating the two QEMU boards
tests/lifecycle-uefi/api-launcher.test.ts          # a fixture enumerating the two QEMU boards
tests/apid-api/src/selftest.ts                     # labels the two QEMU architectures by their boards
tests/rootfs-manifest-test.sh                      # asserts the pinned boards' resolved package sets
tests/product-test.sh                              # asserts the committed products' recipes
tests/rootfs-runtime/selection_test.py             # fixtures over the pinned boards' packages
tests/boot-startup-package-test.sh                 # spells the EFI architectures as UEFI does (x64, aa64), which are also board names
tests/boot-startup-pack-fixture.sh                 # passes the EFI architecture as UEFI spells it (x64), which is also a board name
tests/boot-initramfs-test.sh                       # packs the initramfs for the EFI architecture as UEFI spells it (x64), which is also a board name
tests/release-test.sh                              # fixture releases of the committed products' boards
