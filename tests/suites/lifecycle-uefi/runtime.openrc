#!/sbin/openrc-run
# The file deployment runtime acceptance on an OpenRC root: runtime.service's counterpart. Started in the
# background by start-stop-daemon, so it runs with the bounding set every daemon of the root has.

description="File deployment runtime acceptance"
command=/usr/lib/mica/test-file-runtime
command_background=yes
pidfile=/run/test-file-runtime.pid

# Not `need apid`: on a product only micad starts apid (its web reconciler), and a runlevel that pulls apid in as
# well races it -- micad renders /run/mica/apid.json afresh each boot and restarts an apid already running, and the
# runlevel then finds apid stopping ("cannot start test-file-runtime as apid would not start"). runtime.sh waits
# for apid to be active instead.
depend() {
    need micad
}
