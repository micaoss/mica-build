# check=skip=InvalidDefaultArgInFrom
# U-Boot's sandbox build at the commit mica-boards:boards/cx3576/loader/Dockerfile
# builds for the board, so the FIT verification code the proofs drive is the
# code that ships. The sandbox is a hosted binary: it runs on this container
# and executes the same image-verification path a board would.
#
# The commit is an ARG with the board's value as its default, so a bump there
# is one edit here. libgnutls28-dev and efitools are not optional: the tools
# and lib/efi_loader targets of this tree need mkeficapsule's headers and
# cert-to-efi-sig-list, and without them the build stops in the middle.
ARG MICA_IMAGE_UBUNTU_2404
FROM ${MICA_IMAGE_UBUNTU_2404} AS build
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates build-essential bc bison flex libssl-dev \
        python3 python3-dev python3-setuptools swig uuid-dev \
        device-tree-compiler openssl libgnutls28-dev efitools && \
    rm -rf /var/lib/apt/lists/*
ARG UBOOT_REPO=https://github.com/u-boot/u-boot.git
ARG UBOOT_COMMIT=ece349ade2973e220f524ce59e59711cc919263f
RUN git init /uboot && cd /uboot && git remote add origin "${UBOOT_REPO}" && \
    git fetch --depth 1 origin "${UBOOT_COMMIT}" && git checkout FETCH_HEAD && rm -rf .git
RUN cd /uboot && make sandbox_defconfig && \
    scripts/config --disable SANDBOX_SDL --disable VIDEO_SANDBOX_SDL \
                   --enable FIT --enable FIT_SIGNATURE --enable FIT_FULL_CHECK \
                   --enable RSA --enable RSA_VERIFY --enable CMD_BOOTM \
                   --enable IMAGE_SIGN_INFO --enable LEGACY_IMAGE_FORMAT && \
    make olddefconfig && \
    for s in CONFIG_FIT=y CONFIG_FIT_SIGNATURE=y CONFIG_RSA=y CONFIG_RSA_VERIFY=y CONFIG_FIT_FULL_CHECK=y; do \
        grep -q "^${s}$" .config || { echo "error: ${s} did not survive olddefconfig, so this sandbox would verify nothing" >&2; exit 1; }; done && \
    make -j$(nproc) && ls -la u-boot tools/mkimage
