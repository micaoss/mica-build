# Files that name a board on purpose, one repository-relative path per line,
# the reason after `#`. Everything else in the lint's scope dispatches on facts.
tests/suites/signed-boot-lab/cx3576-control-fdt.sh        # a lab of one board's U-Boot control FDT
tests/suites/signed-boot-lab/cx3576-control-fdt-inner.sh  # the same lab, inside the sandbox
tests/suites/signed-boot-lab/fit-sandbox.sh               # slices the one FIT board's real kernel and DTB
tests/suites/signed-boot-lab/fit-sandbox-inner.sh         # the same lab, inside the sandbox
tests/suites/signed-boot-lab/verity-matrix.sh             # names the three boards' kernels in its hint
tests/suites/signed-boot-lab/uefi-uki.sh                  # spells the EFI architecture as UEFI does (x64), which is also a board's name
tests/suites/lifecycle-uboot-fit/firmware-io.sh           # compiles both FIT boards' loader sources, one flag each
tests/suites/lifecycle-uboot-fit/image.py                 # inspects the rockchip medium by name
tests/suites/lifecycle-uefi/native-input.test.ts          # a fixture enumerating the two QEMU boards
tests/suites/lifecycle-uefi/api-launcher.test.ts          # a fixture enumerating the two QEMU boards
tests/suites/apid-api/src/selftest.ts                     # labels the two QEMU architectures by their boards
tests/gates/rootfs-manifest-test.sh                      # asserts the pinned boards' resolved package sets
tests/gates/product-test.sh                              # asserts the committed products' recipes
tests/suites/rootfs-runtime/selection.test.ts             # fixtures over the pinned boards' packages
tests/gates/boot-startup-package-test.sh                 # spells the EFI architectures as UEFI does (x64, aa64), which are also board names
tests/gates/boot-startup-pack-fixture.sh                 # passes the EFI architecture as UEFI spells it (x64), which is also a board name
tests/gates/boot-initramfs-test.sh                       # packs the initramfs for the EFI architecture as UEFI spells it (x64), which is also a board name
tests/gates/release-test.sh                              # fixture releases of the committed products' boards
tests/gates/boot-signing-test.sh                         # signs the loader for the EFI architecture as UEFI spells it (x64), which is also a board name
tests/gates/publish-test.sh                              # drives the board publishers over two real boards of the tree
tests/gates/version-guard-test.sh                        # drives the package-version guard over one real board's producer
