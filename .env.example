# Environment keys this tree reads. Placeholders only; a real .env is
# git-ignored. Every key has a default, so nothing here is required.

# --- build/ and verify/ (Bun) ----------------------------------------------
# A host bun to run the suites with, or 1 to force the pinned container.
MICA_BUILD_BUN=
MICA_BUILD_CONTAINER=
MICA_VERIFY_BUN=
MICA_VERIFY_CONTAINER=
# Docker binary for the toolbox containers.
MICA_BUILD_DOCKER=

# --- products ---------------------------------------------------------------
# The product src/rootfs/build.ts composes (products/<name>).
MICA_PRODUCT=
# 1 composes without the build cache.
MICA_ROOTFS_NO_CACHE=
# Imported packages whose digest check a development root waives.
MICA_POOL_UNLOCKED=

# --- signing ----------------------------------------------------------------
# The signing workspace (default meta/, created by make os-devkeys).
MICA_SIGNING_OUTPUT=
# The verity certificate the board kernels must embed (default meta/verity/signer.cert.pem).
MICA_VERITY_TRUST_CERT=
